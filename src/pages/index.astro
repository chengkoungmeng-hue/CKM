---
// src/pages/index.astro — Khmer homepage
//
// Layout rationale (2026-08-14 rebuild):
//  - The page used to be six interchangeable slabs: py-20, centred heading, grid.
//    Section rhythm now varies, and only some headers are centred, so the eye has
//    somewhere to go.
//  - The dish photography moved from fifth position to second. For a caterer the
//    food IS the pitch; it was buried under three text sections.
//  - `tracking-widest` has been stripped from every Khmer string. Khmer is a
//    clustered script — letter-spacing separates a base consonant from its
//    subscript and diacritics and makes the text harder to read, not airier.
//  - The dead `.reveal` classes are gone. They were scoped to Layout.astro and
//    never matched anything here, and no observer ever added `.active`.
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Phone, Send, Utensils, Building2, Zap, Award, Clock, Sparkles, ChevronRight, ArrowDown } from '@lucide/astro';

import { getCollection } from 'astro:content';
import CateringPulse from '../components/CateringPulse.astro';

import {
  telegramLink,
  facebookLink,
  heroImageRelative,
  logo,
  mainPhone,
  phoneNumbers,
  menuItems
} from '../data/homeData';

const menuImagesGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/processed_images_ai/menu-*.png', { eager: true });
const menuImages = Object.values(menuImagesGlob).map(m => m.default);

const altTexts = menuItems.km.map(item => item.alt || item.title);
const dishTitles = menuItems.km.map(item => item.title);

const allPostsRaw = await getCollection('blog', ({ id }) => !id.includes('/'));
const allPosts = [...allPostsRaw].sort((a, b) => b.id.localeCompare(a.id));

const featuredPosts = allPosts.filter(post => post.data.featured);
const otherPosts = allPosts.filter(post => !post.data.featured);
const recentPosts = [...featuredPosts, ...otherPosts].slice(0, 3);

const telHref = `tel:+855${mainPhone.replace(/\s/g, '').substring(1)}`;

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "តើម៉ឺនុយម្ហូបការ អាចកែសម្រួលតាមតម្រូវការរបស់លោកអ្នកបានទេ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "បាទ/ចាស បានទាំងស្រុង។ ម៉ឺនុយនីមួយៗត្រូវបានរៀបចំតាមតម្រូវការជាក់លាក់របស់ម្ចាស់កម្មវិធី ព្រោះជម្រើសវត្ថុធាតុដើម ដូចជាកម្រិតប៉ាវហឺ ប្រភេទត្រី ឬបង្កង ព្រមទាំងចំនួនតុ និងទីតាំងកម្មវិធី សុទ្ធតែធ្វើឱ្យម៉ឺនុយខុសៗគ្នា។ សូមប្រាប់យើងខ្ញុំពីចំនួនតុ កាលបរិច្ឆេទ និងទីតាំង យើងខ្ញុំនឹងរៀបចំម៉ឺនុយលម្អិតជូនលោកអ្នក។"
      }
    },
    {
      "@type": "Question",
      "name": "តើ CKM មានសេវាជួលរោងការ និងតុបតែងទីតាំងកម្មវិធីដែរឬទេ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "បាទ/ចាស! ក្រៅពីសេវាកម្មចម្អិនម្ហូប យើងខ្ញុំមានសេវាកម្មរៀបចំទីតាំង ជួលរោង និងរៀបចំប្រព័ន្ធភ្លើង និងតុបតែងទីតាំងកម្មវិធីឱ្យបានស្អាត និងរៀបរយ។"
      }
    },
    {
      "@type": "Question",
      "name": "តើ CKM ទទួលរៀបចំកម្មវិធីអ្វីខ្លះនៅភ្នំពេញ និងតាមខេត្ត?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "យើងខ្ញុំទទួលរៀបចំពិធីសារពាង្គការមង្គលការ ពិធីជប់លៀងឡើងផ្ទះថ្មី ពិធីបុណ្យ ពិធីជប់លៀងក្រុមហ៊ុន និងអាហារប៊ូហ្វេ ទាំងនៅក្នុងរាជធានីភ្នំពេញ និងបណ្តាខេត្តនានា។"
      }
    }
  ]
});
---
<Layout title="ចេង គួងម៉េង (CKM) | សេវាកម្មម្ហូបការ ភ្នំពេញ និងចុងភៅរៀបចំម្ហូបការមង្គលការ" description="ចេង គួងម៉េង (CKM) ផ្តល់ជូនសេវាកម្មម្ហូបការ សេវាកម្មទទួលរៀបចំកម្មវិធី និងចុងភៅរៀបចំម្ហូបការមង្គលការលំដាប់ខ្ពស់នៅភ្នំពេញ។ មានម៉ឺនុយ ៨ មុខ កូនជ្រូកខ្វៃ ស៊ុបប៉ាវហឺ និងសេវាកម្មរៀបចំតុបតែងទីតាំងពេញលេញ។" lang="km-KH">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>

  <style>
    .font-km-serif { font-family: 'Hanuman', serif; }
    .font-km-sans { font-family: 'Kantumruy Pro', sans-serif; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

    /* A hairline in champagne reads as deliberate; a slate-200 border reads as a
       default. Used to open every section instead of a full-width divider. */
    .rule-gold {
      width: 3rem;
      height: 1px;
      background: linear-gradient(90deg, #C5A059, rgba(197,160,89,0));
    }
    /* Khmer needs generous leading — the subscripts sit well below the baseline
       and collide with the line above at anything tighter than ~1.7. */
    .lead-km { line-height: 1.9; }
    /* Every eyebrow on this page is Khmer, so it gets NO letter-spacing — the same
       rule that removed tracking-widest from the body copy applies here. Khmer has
       no letter case either, so uppercase would be a no-op. The label reads as a
       label through size and weight instead. */
    .eyebrow {
      font-size: 0.6875rem;
      font-weight: 700;
    }
    @media (min-width: 768px) {
      .eyebrow { font-size: 0.75rem; }
    }
    @media (min-width: 768px) {
      .dish-feature { grid-column: span 2; grid-row: span 2; }
      /* The closing tile spans two columns but must stay ONE row tall, so its height
         has to come from the grid row rather than from an aspect ratio. Tailwind's
         md:aspect-auto lost to aspect-square here, which stretched the tile to
         608x608 and doubled the height of the final row — hence !important. */
      .dish-last { grid-column: span 2; aspect-ratio: auto !important; }
    }
  </style>

  <article class="w-full">

    <!-- ── Hero ─────────────────────────────────────────────────────────────
         Tightened from the previous full-screen version: the logo was 176px and
         the h1 sat 344px down, which pushed the call button behind the fixed
         mobile CTA bar. Everything above the fold now fits on a 375x812 screen. -->
    <!-- svh, not vh: on a real phone the browser chrome expands and collapses, and
         100vh is the *largest* height, so a vh-sized hero is taller than the visible
         area on first paint. svh is the smallest, which is what should fit.
         Content sits above centre on mobile (justify-start + padding) — centring it
         left 214px of dead space above the logo before anything readable appeared. -->
    <header class="relative min-h-[calc(100svh-4rem)] md:min-h-[calc(100svh-5rem)] flex flex-col items-center justify-start md:justify-center overflow-hidden pt-10 pb-14 md:py-20">
      <Image src={heroImageRelative} format="avif" quality={45} alt="ទិដ្ឋភាពរៀបចំម្ហូបការដោយក្រុមចុងភៅ CKM" width={1920} height={1080} widths={[400, 768, 1200, 1920]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover object-center" fetchpriority="high" loading="eager" decoding="sync" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/65 to-onyx"></div>

      <div class="relative z-10 text-center px-5 max-w-3xl mx-auto">
        <Image src={logo} format="avif" quality={70} alt="និមិត្តសញ្ញាក្រុមចុងភៅ ចេង គួងម៉េង" width={128} height={128} widths={[80, 96, 128]} sizes="(max-width: 768px) 80px, 112px" class="w-20 h-20 md:w-28 md:h-28 rounded-full border border-champagne/60 mx-auto mb-6 md:mb-8" fetchpriority="high" loading="eager" decoding="sync" />

        <p class="eyebrow text-champagne font-km-sans mb-4">ភ្នំពេញ · បទពិសោធន៍ ៦០ ឆ្នាំ</p>

        <h1 class="text-[1.75rem] leading-[1.5] md:text-5xl md:leading-[1.35] font-km-serif font-bold text-white mb-5">
          ក្រុមចុងភៅ <span class="text-champagne">ចេង គួងម៉េង</span>
        </h1>

        <p class="text-base md:text-xl font-km-sans text-slate-200 lead-km mb-8 md:mb-10 max-w-xl mx-auto">
          រៀបចំម្ហូបការប្រពៃណីខ្មែរ-ចិន សម្រាប់ពិធីមង្គលការ ពិធីឡើងផ្ទះថ្មី និងកម្មវិធីក្រុមហ៊ុន ទាំងក្នុងភ្នំពេញ និងតាមខេត្ត។
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-sm sm:max-w-none mx-auto">
          <a href={telHref} class="bg-champagne hover:bg-[#d6b76c] text-onyx px-7 py-4 rounded-sm font-km-sans font-bold text-base transition-colors flex items-center justify-center gap-2.5 shadow-lg">
            <Phone class="w-[18px] h-[18px]" stroke-width={2} />
            <span>{mainPhone}</span>
          </a>
          <a href={telegramLink} target="_blank" rel="noopener noreferrer" class="border border-champagne/50 hover:border-champagne text-champagne hover:text-white px-7 py-4 rounded-sm font-km-sans font-medium text-base transition-colors flex items-center justify-center gap-2.5">
            <Send class="w-[18px] h-[18px]" stroke-width={1.75} />
            <span>ផ្ញើសារតាមតេឡេក្រាម</span>
          </a>
        </div>
      </div>

      <a href="#gallery" aria-hidden="true" tabindex="-1" class="hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 z-10 text-champagne/60 hover:text-champagne transition-colors">
        <ArrowDown class="w-5 h-5" stroke-width={1.5} />
      </a>
    </header>

    <!-- ── Proof strip ──────────────────────────────────────────────────────
         The previous version formatted two adjectives (ឆ្ងាញ់ "tasty",
         ស្អាត "clean") as if they were statistics, next to two real numbers.
         Adjectives dressed as data undermine the numbers beside them. -->
    <section class="bg-onyx border-b border-white/5">
      <div class="max-w-5xl mx-auto px-6 py-10 md:py-12">
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-4 text-center">
          <div>
            <dt class="text-3xl md:text-4xl font-km-serif font-bold text-champagne mb-1.5 tabular-nums">៦០+</dt>
            <dd class="text-slate-400 text-[13px] md:text-sm font-km-sans">ឆ្នាំនៃបទពិសោធន៍</dd>
          </div>
          <div>
            <dt class="text-3xl md:text-4xl font-km-serif font-bold text-champagne mb-1.5 tabular-nums">៨ មុខ</dt>
            <dd class="text-slate-400 text-[13px] md:text-sm font-km-sans">ម៉ឺនុយប្រពៃណីខ្មែរ-ចិន</dd>
          </div>
          <div>
            <dt class="text-3xl md:text-4xl font-km-serif font-bold text-champagne mb-1.5">ភ្នំពេញ</dt>
            <dd class="text-slate-400 text-[13px] md:text-sm font-km-sans">និងបណ្តាខេត្ត</dd>
          </div>
          <div>
            <dt class="text-3xl md:text-4xl font-km-serif font-bold text-champagne mb-1.5">ចល័ត</dt>
            <dd class="text-slate-400 text-[13px] md:text-sm font-km-sans">ផ្ទះបាយដល់ទីតាំង</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ── Dishes ───────────────────────────────────────────────────────────
         Moved up from fifth position. The first tile spans 2x2 on desktop so the
         grid has a focal point instead of sixteen equal squares. -->
    <section id="gallery" class="py-16 md:py-28 bg-pearl">
      <div class="max-w-7xl mx-auto px-5 md:px-6">
        <div class="max-w-2xl mb-10 md:mb-14">
          <div class="rule-gold mb-5"></div>
          <p class="eyebrow text-champagne-dark font-km-sans mb-3">ម៉ឺនុយម្ហូបការ</p>
          <h2 class="text-2xl md:text-4xl font-km-serif font-bold text-onyx leading-[1.45] mb-4">មុខម្ហូបប្រចាំតុរបស់យើងខ្ញុំ</h2>
          <p class="text-slate-600 font-km-sans lead-km text-[15px] md:text-base">
            មុខម្ហូបដែលយើងខ្ញុំរៀបចំជាប្រចាំក្នុងពិធីមង្គលការ និងកម្មវិធីជប់លៀង។ ម៉ឺនុយអាចកែសម្រួលតាមចំនួនតុ និងចំណូលចិត្តរបស់លោកអ្នក។
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 md:gap-4">
          {/* Cell arithmetic, 4 columns on desktop: the feature tile takes 2x2 = 4 cells,
              the 14 middle tiles take 1 each, which leaves 18 — three short of a clean
              five rows and one empty cell in the bottom-right corner. Letting the LAST
              tile span two columns brings it to 20 and closes the gap without needing a
              seventeenth photograph. It also gives the grid a deliberate close: wide at
              the end, mirroring the large tile at the start.
              Mobile is untouched — two columns and sixteen squares divide evenly. */}
          {menuImages.map((img, i) => (
            <figure class={`group relative overflow-hidden rounded-sm bg-slate-100 ${i === 0 ? 'dish-feature' : ''} ${i === menuImages.length - 1 ? 'dish-last aspect-square' : 'aspect-square'}`}>
              <Image src={img} alt={altTexts[i] || `រូបភាពម្ហូបការ CKM ទី ${i + 1}`} format="avif" quality={80} widths={i === 0 || i === menuImages.length - 1 ? [400, 800] : [200, 400]} sizes={i === 0 ? '(max-width: 768px) 50vw, 50vw' : i === menuImages.length - 1 ? '(max-width: 768px) 50vw, 50vw' : '(max-width: 768px) 50vw, 25vw'} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-[1.04]" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption class="absolute inset-x-0 bottom-0 p-3 md:p-4 bg-gradient-to-t from-onyx/90 via-onyx/40 to-transparent">
                <span class={`font-km-sans text-white leading-snug block ${i === 0 ? 'text-sm md:text-lg font-bold' : 'text-[11px] md:text-[13px]'}`}>{dishTitles[i]}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Services ─────────────────────────────────────────────────────────
         These three cards previously sat under a heading that read
         "អត្ថបទវិភាគ និងការណែនាំលម្អិត" — "analysis articles and detailed
         guides". They are services, not articles. -->
    <section id="services" class="py-16 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-5 md:px-6">
        <div class="max-w-2xl mb-10 md:mb-14">
          <div class="rule-gold mb-5"></div>
          <p class="eyebrow text-champagne-dark font-km-sans mb-3">សេវាកម្ម</p>
          <h2 class="text-2xl md:text-4xl font-km-serif font-bold text-onyx leading-[1.45] mb-4">យើងខ្ញុំទទួលធ្វើអ្វីខ្លះ</h2>
          <p class="text-slate-600 font-km-sans lead-km text-[15px] md:text-base">
            ចាប់ពីម្ហូប រហូតដល់រោង តុ កៅអី និងប្រព័ន្ធភ្លើង។ លោកអ្នកមិនចាំបាច់ទាក់ទងអ្នកផ្គត់ផ្គង់ច្រើនកន្លែងឡើយ។
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-200">
          <article class="bg-white p-7 md:p-9">
            <span class="eyebrow text-slate-400 font-sans block mb-5 tabular-nums">០១</span>
            <Utensils class="w-7 h-7 text-champagne-dark mb-5" stroke-width={1.5} />
            <h3 class="text-lg md:text-xl font-km-serif font-bold text-onyx mb-3 leading-relaxed">ម្ហូបការប្រពៃណី និងតុបតែងទីតាំង</h3>
            <p class="text-slate-600 font-km-sans lead-km text-[15px]">
              រៀបចំម្ហូបសម្រាប់ពិធីសារពាង្គការប្រពៃណីខ្មែរ ព្រមទាំងជួលរោង តុ កៅអី និងតុបតែងទីតាំងកម្មវិធី។
            </p>
          </article>

          <article class="bg-white p-7 md:p-9">
            <span class="eyebrow text-slate-400 font-sans block mb-5 tabular-nums">០២</span>
            <Building2 class="w-7 h-7 text-champagne-dark mb-5" stroke-width={1.5} />
            <h3 class="text-lg md:text-xl font-km-serif font-bold text-onyx mb-3 leading-relaxed">ពិធីជប់លៀងបែបចិន និងកម្មវិធីក្រុមហ៊ុន</h3>
            <p class="text-slate-600 font-km-sans lead-km text-[15px]">
