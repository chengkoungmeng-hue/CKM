---
import Layout from "../layouts/Layout.astro";

const title = "លក្ខខណ្ឌនៃការប្រើប្រាស់ | CKM";
const description = "លក្ខខណ្ឌនៃការប្រើប្រាស់គេហទំព័ររបស់ ចេង គួងម៉េង។ គេហទំព័រនេះមិនទទួលការបញ្ជាទិញ ហើយម៉ឺនុយនិងតម្លៃត្រូវបញ្ជាក់ដោយផ្ទាល់ជាមួយក្រុមការងារ។";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ទំព័រដើម",
      "item": "https://ckmkh.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "លក្ខខណ្ឌនៃការប្រើប្រាស់",
      "item": "https://ckmkh.com/terms/"
    }
  ]
});
---

<Layout title={title} description={description} lang="km">
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema}></script>
  <div class="max-w-4xl mx-auto px-6 py-24 md:py-32 font-sans text-slate-300 leading-relaxed">
    <div class="mb-12 border-b border-slate-800 pb-8">
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-amber-500 mb-4 leading-tight">លក្ខខណ្ឌនៃការប្រើប្រាស់</h1>
      <p class="text-sm text-slate-500">កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាពចុងក្រោយ: ថ្ងៃទី 22 ខែសីហា ឆ្នាំ 2026</p>
    </div>

    <div class="space-y-10 text-sm md:text-base opacity-90">
      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 1. អំពីគេហទំព័រនេះ
        </h2>
        <p>គេហទំព័រនេះជាគេហទំព័រព័ត៌មានរបស់ CKM Catering (ចេង គួងម៉េង) ដែលមានគោលបំណងបង្ហាញអំពីសេវាកម្មម្ហូបការ ម៉ឺនុយ និងស្នាដៃកន្លងមក ដើម្បីឱ្យលោកអ្នកមានព័ត៌មានគ្រប់គ្រាន់មុនពេលទាក់ទងមកយើងខ្ញុំ។ គេហទំព័រនេះមិនទទួលការបញ្ជាទិញ មិនមានប្រព័ន្ធកក់តាមអនឡាញ មិនមានទម្រង់បំពេញព័ត៌មាន និងមិនទទួលការទូទាត់ប្រាក់ឡើយ។ រាល់ការសាកសួរ និងការកក់សេវាកម្មកើតឡើងនៅក្រៅគេហទំព័រនេះ គឺដោយផ្ទាល់ជាមួយក្រុមការងាររបស់យើងតាមរយៈទូរស័ព្ទ ឬ Telegram។ ការបន្តប្រើប្រាស់គេហទំព័រនេះមានន័យថាលោកអ្នកយល់ព្រមតាមលក្ខខណ្ឌដែលមានចែងខាងក្រោម។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 2. ម៉ឺនុយ មុខម្ហូប រូបភាព និងតួលេខ
        </h2>
        <p>ម៉ឺនុយ មុខម្ហូប រូបភាព និងតួលេខទាំងឡាយដែលបង្ហាញនៅលើគេហទំព័រនេះ គឺសម្រាប់ជាឯកសារយោងតែប៉ុណ្ណោះ។ ម៉ឺនុយពិតប្រាកដ ចំនួន និងតម្លៃសម្រាប់កម្មវិធីនីមួយៗ ត្រូវបានបញ្ជាក់ដោយផ្ទាល់ជាមួយក្រុមការងាររបស់យើងនៅពេលកក់សេវាកម្ម ដោយផ្អែកលើចំនួនភ្ញៀវ ទីតាំង កាលបរិច្ឆេទ និងមុខម្ហូបដែលលោកអ្នកជ្រើសរើស។ ព័ត៌មានដែលបង្ហាញនៅទីនេះមិនមែនជាការស្នើតម្លៃដែលមានកាតព្វកិច្ចផ្លូវច្បាប់ឡើយ ហើយវាក៏អាចផ្លាស់ប្តូរបានដែរ នៅពេលម៉ឺនុយ ឬគ្រឿងផ្សំតាមរដូវផ្លាស់ប្តូរ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 3. ការកក់ ការទូទាត់ និងការលុបចោល
        </h2>
        <p>លក្ខខណ្ឌនៃការកក់ ការទូទាត់ប្រាក់ និងការលុបចោល ត្រូវបានព្រមព្រៀងគ្នាដោយផ្ទាល់រវាងលោកអ្នក និងក្រុមការងាររបស់យើងនៅពេលកក់សេវាកម្ម។ លក្ខខណ្ឌទាំងនោះមិនត្រូវបានកំណត់ដោយគេហទំព័រនេះទេ ហើយក៏មិនត្រូវបានបង្ហោះនៅលើគេហទំព័រនេះដែរ។ ដូច្នេះ សូមសាកសួរ និងព្រមព្រៀងគ្នាឱ្យបានច្បាស់លាស់ជាមួយក្រុមការងាររបស់យើងជាមុនសិន មុនពេលបញ្ជាក់ការកក់។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 4. កម្មសិទ្ធិលើខ្លឹមសារ
        </h2>
        <p>អត្ថបទ រូបភាព ស្លាកសញ្ញា និងការរចនានៅផ្នែកសេវាកម្មរបស់គេហទំព័រនេះ ជាកម្មសិទ្ធិរបស់ CKM Catering។ អត្ថបទខ្មែរនៅផ្នែក "បច្ចុប្បន្នភាព និងនិន្នាការម្ហូបការអន្តរជាតិ" (/pulse/) ត្រូវបានសរសេរឡើងដោយប្រព័ន្ធស្វ័យប្រវត្តិរបស់យើងខ្ញុំ ហើយជាកម្មសិទ្ធិរបស់ CKM Catering ដូចគ្នា។</p>
        <p class="mt-4">ចំណែករូបភាពនៅផ្នែកនោះវិញ ជាបណ្ណអក្សរដែលបង្កើតឡើងដោយស្វ័យប្រវត្តិពីអត្ថបទខ្មែររបស់យើងខ្ញុំផ្ទាល់ ដូច្នេះវាមិនមែនជារូបថតរបស់នរណាម្នាក់ផ្សេងឡើយ។</p>
        <p class="mt-4">លោកអ្នកអាចអាន រក្សាទុក និងចែករំលែកខ្លឹមសារដែលជាកម្មសិទ្ធិរបស់យើងខ្ញុំសម្រាប់ការប្រើប្រាស់ផ្ទាល់ខ្លួន ដោយភ្ជាប់មកជាមួយនូវការបញ្ជាក់ប្រភព និងតំណភ្ជាប់មកកាន់គេហទំព័រនេះ។ ការអនុញ្ញាតនេះមិនរាប់បញ្ចូលរូបភាពរបស់ភាគីទីបីឡើយ ព្រោះយើងខ្ញុំគ្មានសិទ្ធិផ្តល់ការអនុញ្ញាតលើរូបភាពដែលមិនមែនជារបស់យើងខ្ញុំ។ ចំណែកការយកទៅប្រើឡើងវិញសម្រាប់គោលបំណងពាណិជ្ជកម្ម ការផ្សាយពាណិជ្ជកម្ម ឬការបង្ហាញថាជាស្នាដៃរបស់អ្នកផ្សេងវិញ ត្រូវមានការអនុញ្ញាតជាលាយលក្ខណ៍អក្សរពីយើងខ្ញុំជាមុនសិន។ ប្រសិនបើលោកអ្នកជាម្ចាស់សិទ្ធិលើរូបភាពណាមួយ ហើយចង់ឱ្យដកចេញ សូមមើលរបៀបទាក់ទងនៅទំព័រ <a href="/disclaimer/" class="text-amber-500 hover:text-amber-400 underline underline-offset-4">ការបដិសេធការទទួលខុសត្រូវ</a>។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 5. តំណភ្ជាប់ទៅសេវាកម្មភាគីទីបី
        </h2>
        <p>គេហទំព័រនេះមានតំណភ្ជាប់ទៅកាន់សេវាកម្មខាងក្រៅ ដូចជា Telegram, Facebook និងតំណហៅទូរស័ព្ទ។ នៅពេលលោកអ្នកចុចតំណទាំងនោះ លោកអ្នកចាកចេញពីគេហទំព័រនេះ ហើយចូលទៅកាន់សេវាកម្មដែលគ្រប់គ្រងដោយប្រតិបត្តិករផ្សេង ក្រោមលក្ខខណ្ឌ និងគោលការណ៍ឯកជនភាពរបស់ប្រតិបត្តិករទាំងនោះ។ យើងខ្ញុំមិនអាចគ្រប់គ្រងខ្លឹមសារ ភាពអាចប្រើប្រាស់បាន ឬវិធីដែលសេវាកម្មទាំងនោះដំណើរការទិន្នន័យរបស់លោកអ្នកបានឡើយ។ ក្រៅពីនេះ អត្ថបទមួយចំនួននៅលើគេហទំព័រនេះមានតំណភ្ជាប់ទៅកាន់ប្រភពដើមខាងក្រៅ ដែលស្ថិតនៅក្រោមកម្មសិទ្ធិ និងការទទួលខុសត្រូវរបស់ម្ចាស់ប្រភពនោះ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 6. ច្បាប់ដែលត្រូវអនុវត្ត
        </h2>
        <p>លក្ខខណ្ឌនៃការប្រើប្រាស់នេះ ស្ថិតនៅក្រោមច្បាប់នៃព្រះរាជាណាចក្រកម្ពុជា។ ប្រសិនបើមានចំណុចណាមួយមិនច្បាស់លាស់ ឬមានការយល់ខុសគ្នា យើងខ្ញុំលើកទឹកចិត្តឱ្យលោកអ្នកពិភាក្សាដោយផ្ទាល់ជាមួយក្រុមការងាររបស់យើងជាមុនសិន។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 7. ការធ្វើបច្ចុប្បន្នភាព និងទំនាក់ទំនង
        </h2>
        <p>យើងខ្ញុំអាចធ្វើបច្ចុប្បន្នភាពលក្ខខណ្ឌនេះ នៅពេលខ្លឹមសារ ឬមុខងារនៃគេហទំព័រមានការផ្លាស់ប្តូរ។ កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាពចុងក្រោយត្រូវបានបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនេះ។ ប្រសិនបើលោកអ្នកមានសំណួរ ឬកង្វល់ណាមួយទាក់ទងនឹងលក្ខខណ្ឌនេះ សូមទាក់ទងមកក្រុមការងាររបស់យើងផ្ទាល់តាមរយៈប្រព័ន្ធ Telegram ឬលេខទូរស័ព្ទដែលបានផ្តល់ជូននៅលើគេហទំព័រ។</p>
      </section>
    </div>

    <div class="mt-16 pt-8 border-t border-slate-800 flex justify-center">
