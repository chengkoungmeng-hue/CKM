---
// 實體路徑: src/pages/pulse/[id].astro
// 狀態: 終極高棉語美食動態詳情頁 - 支援真實圖片、雙重 Slug 與快取刷新
import Layout from '../../layouts/Layout.astro';
import pulseData from '../../data/pulseData.json';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowRight, ArrowUpRight, Calendar, Tag, User, Quote, BookOpen, Clock, Send, Globe } from '@lucide/astro';

export const prerender = true;

export async function getStaticPaths() {
  const items = (pulseData || []) as any[];
  const validItems = items.filter((item: any) => item && item.id);
  const paths: any[] = [];
  
  for (const item of validItems) {
    const primarySlug = item.slug || item.id;
    // Both routes stay reachable so older /pulse/pulse-NN/ links keep working,
    // but both declare the slug URL as canonical.
    paths.push({ params: { id: primarySlug }, props: { item, canonicalId: primarySlug } });

    if (item.slug && item.id && item.slug !== item.id) {
      paths.push({ params: { id: item.id }, props: { item, canonicalId: primarySlug } });
    }
  }

  if (paths.length === 0) {
    paths.push({ params: { id: 'pulse-01' }, props: { item: { id: 'pulse-01', slug: 'pulse-01', title_km: 'បច្ចុប្បន្នភាពអន្តរជាតិ', summary_km: '', category: 'សេវាកម្មធ្វើម្ហូបចល័ត', image_url: '/images/blog_01_inline_khmer.webp', pub_date: '' } } });
  }

  return paths;
}
// Trigger HMR route re-evaluation for normalized SEO slugs

const { item = {}, canonicalId } = Astro.props as any;

// Fetch 3 highly relevant & evenly distributed blog posts to pass Link Juice (internal link equity)
const allBlogPosts = await getCollection('blog', ({ id }) => !id.includes('/'));
allBlogPosts.sort((a, b) => a.id.localeCompare(b.id));

// The whole point of /pulse/ is to catch long-tail search traffic and pass the reader
// on to the articles that actually sell. That only works if the onward link is about
// something the reader just showed interest in.
//
// The previous scoring awarded +10 when a pulse CATEGORY string appeared in a blog
// title — but the categories are pulse-only taxonomy labels (ម្ហូបខ្មែរប្រណីត,
// គ្រឿងផ្សំនិងរសជាតិ …) and they appear in exactly zero of the 15 blog titles or
// descriptions. That branch never fired once, so the remaining generic +3s and the
// rotation tie-breaker decided everything: the "related articles" were round-robin.
// A reader finishing a piece on abalone broth could be handed tent logistics.
//
// Now: score on real term overlap between the blog post and the pulse text.
const pulseHaystack = [
  item.title_km || '',
  item.summary_km || '',
  item.content_km || '',
  (item.key_points_km || []).join(' '),
].join(' ');

// Khmer does NOT put spaces between words — a space separates phrases, not words. So
// splitting on whitespace yields whole clauses, and an exact substring match on a clause
// never fires. Match on the article's own target_keyword instead, which is short and
// dish-specific ("ស៊ុបប៉ាវហឺ", "ចុងភៅខ្មែរ", "តម្លៃម្ហូបការ"), plus a sliding window over
// it so a partial mention still counts.
// Terms so common across catering copy that matching them tells us nothing. A sliding
// window over the keyword generated exactly these, and "អនាម័យនិងសុវត្ថិភាពម្ហូបអាហារ"
// then matched every single pulse article through the fragment "ម្ហូបអាហារ".
const GENERIC_TERMS = [
  'ម្ហូបអាហារ', 'ម្ហូបការ', 'សេវាកម្ម', 'អាហារ', 'ម្ហូប', 'ការរៀបចំ', 'រសជាតិ',
];

const keywordVariants = (kw: string) => {
  const clean = (kw || '').replace(/[^ក-៿\s]/g, '').trim();
  if (!clean) return [];
  // Whole phrases only — no sliding window. A target_keyword is already short and
  // dish-specific ("ស៊ុបប៉ាវហឺ", "ចុងភៅនៅភ្នំពេញ", "តម្លៃម្ហូបការ").
  return clean
    .split(/\s+/)
    .filter((p) => p.length >= 5 && !GENERIC_TERMS.includes(p));
};

const idNumMatch = (item.id || '').match(/\d+/);
const idNum = idNumMatch ? parseInt(idNumMatch[0], 10) : 1;
const seedOffset = ((idNum - 1) * 3) % (allBlogPosts.length || 1);

// The bridge between a pulse article and a blog article is a named banquet dish.
// The generation prompt now requires every pulse piece to tie its technique back to a
// real CKM dish by name, so these are the terms that actually connect the two halves
// of the site. target_keyword alone was not enough: a pulse piece can discuss
// ត្រីចំហុយទឹកស៊ីអ៊ីវ while no blog article carries that as its keyword.
const DISH_TERMS = [
  'ជ្រូកខ្វៃ', 'ស៊ុបប៉ាវហឺ', 'ត្រីចំហុយទឹកស៊ីអ៊ីវ', 'បាយខ្ចប់ស្លឹកឈូក',
  'ញាំជើងទា', 'តុងយាំបង្កងទន្លេ', 'បង្កងបំពង', 'បង្អែមខ្មែរ', 'ទាខ្វៃ',
  'ម៉ឺនុយ ៨ មុខ', 'ចុងភៅ', 'រោងតង់', 'បុគ្គលិកបម្រើ', 'ភ្លក្សរសជាតិ',
  'សីតុណ្ហភាព', 'ថវិកា', 'កញ្ចប់', 'មង្គលការ', 'ឡើងផ្ទះ',
];

const scoredPosts = allBlogPosts.map((post, idx) => {
  let score = 0;

  // 1. target_keyword — the strongest signal when it fires.
  const variants = keywordVariants((post.data as any).target_keyword || '');
  let best = 0;
  for (const v of variants) {
    if (pulseHaystack.includes(v)) best = Math.max(best, v.length);
  }
  score += best * 2;

  // 2. Shared named dishes / topics between the two articles.
  const postText = `${post.data.title} ${post.data.description} ${(post.data as any).target_keyword || ''}`;
  for (const term of DISH_TERMS) {
    if (postText.includes(term) && pulseHaystack.includes(term)) score += 8;
  }

  // Rotation still breaks ties, so link equity stays spread across all 15 posts when
  // several are equally relevant — but relevance now outranks rotation.
  const rotatedRank = (idx + seedOffset) % allBlogPosts.length;
  const tieBreaker = (allBlogPosts.length - rotatedRank) * 0.01;

  return { post, score: score + tieBreaker };
});

scoredPosts.sort((a, b) => b.score - a.score);

// Two slots go to genuine topical relevance; the third is reserved for rotation.
// Pure relevance ranking concentrated links badly — one article collected 14 inbound
// links while another got none at all, which wastes the funnel on the pages that were
// already easiest to reach. Reserving a slot guarantees every pillar article keeps
// receiving link equity without diluting the two relevant recommendations.
const topByRelevance = scoredPosts.slice(0, 2).map((e) => e.post);
const rotationPick = allBlogPosts[(seedOffset + idNum) % allBlogPosts.length];
const relatedPosts = topByRelevance.some((p) => p.id === rotationPick.id)
  ? scoredPosts.slice(0, 3).map((e) => e.post)
  : [...topByRelevance, rotationPick];

const pageTitle = `${item.title_km || 'បច្ចុប្បន្នភាពអន្តរជាតិ'} - CKM`;
const pageDesc = item.summary_km || '';
const itemImage = item.image_url || '/images/blog_01_inline_khmer.webp';

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": item.title_km || '',
  "description": item.summary_km || '',
  // Both fields were invalid and Google discarded the whole NewsArticle node:
  // `image` was a site-relative path (schema.org requires an absolute URL) and
  // `datePublished` was the feed's RFC-2822 string ("Tue, 11 Aug 2026 21:52:03
  // +0000") where ISO 8601 is required.
  "image": [new URL(itemImage, 'https://ckmkh.com').toString()],
  // added_at, not pub_date. pub_date is when the source blog published the
  // recipe; this page is an original Khmer piece written here, so its
  // publication date is when it appeared here. Using the source date told
  // Google that a page written today was six months old. Entries predating
  // added_at fall back to pub_date, the best that is known for them.
  ...((() => {
      const published = item.added_at || item.pub_date;
      return published && !isNaN(new Date(published).getTime())
          ? { "datePublished": new Date(published).toISOString() }
          : {};
  })()),
  "inLanguage": "km-KH",
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://ckmkh.com/pulse/${item.slug || item.id}/` },
  "author": {
    "@type": "Organization",
    "name": "ចេង គួងម៉េង (CKM)"
  }
});
---

<Layout title={pageTitle} description={pageDesc} lang="km-KH" canonical={`/pulse/${canonicalId || item.slug || item.id}/`}>
  <script type="application/ld+json" is:inline set:html={articleSchema}></script>
  <ReadingProgress />

  <style is:global>
    .font-km-serif { font-family: 'Hanuman', serif; }
    .font-km-sans { font-family: 'Kantumruy Pro', sans-serif; }
  </style>

  <div class="w-full bg-pearl min-h-screen pt-24 pb-20 typo-km">
    <div class="max-w-4xl mx-auto px-6">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center flex-wrap gap-2 text-xs font-km-sans text-slate-400 mb-6">
        <a href="/" class="hover:text-champagne-dark transition-colors">ទំព័រដើម</a>
        <span>›</span>
        <a href="/pulse/" class="hover:text-champagne-dark transition-colors">បច្ចុប្បន្នភាព</a>
        <span>›</span>
        <span class="text-slate-600 font-bold truncate max-w-xs md:max-w-md">{item.title_km}</span>
      </nav>

      <!-- Article Meta Bar -->
      <div class="flex flex-wrap items-center justify-start md:justify-center gap-3 text-xs text-slate-500 font-km-sans mb-6 border-b border-slate-200/80 pb-4">
        <div class="flex items-center gap-1.5 font-mono">
          <Calendar class="w-3.5 h-3.5 text-champagne-dark" />
          <span>{(item.added_at || item.pub_date) ? (item.added_at || item.pub_date).split(' ').slice(1, 4).join('.') : '2026.08.08'}</span>
        </div>
        <span>|</span>
        <div class="flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5 text-champagne-dark" />
          <span>អានប្រមាណ ៣ នាទី</span>
        </div>
        <span>|</span>
        <div class="flex items-center gap-1.5">
          <User class="w-3.5 h-3.5 text-champagne-dark" />
          <span>ក្រុមចុងភៅ ចេង គួងម៉េង</span>
        </div>
        <span>|</span>
        <div class="flex items-center gap-1.5 bg-champagne/10 text-champagne-dark px-2.5 py-0.5 rounded-sm border border-champagne/30 font-bold">
          <Tag class="w-3.5 h-3.5" />
          <span>#{item.category || 'ម្ហូបការ'}</span>
        </div>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl md:text-5xl font-km-serif font-bold text-onyx mb-8 leading-relaxed text-left md:text-center max-w-3xl mx-auto py-1">
        {item.title_km}
      </h1>

      <!-- Cover Image Banner with Ambient Frosted Blur Background -->
      <div class="w-full aspect-[16/9] md:aspect-[16/10] max-h-[560px] rounded-sm overflow-hidden bg-onyx/90 mb-12 shadow-sm border border-slate-200/80 mx-auto relative block">
        <!-- Ambient Blurred Background Image -->
        <img 
          src={itemImage} 
          alt={item.image_alt || item.title_km || "CKM Pulse Article"} 
          aria-hidden="true"
          onerror="this.onerror=null; this.src='/images/blog_01_inline_khmer.webp';"
          class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-50 scale-125 pointer-events-none"
        />
        
        <!-- Frosted Vignette Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-onyx/40 via-transparent to-black/20 pointer-events-none z-1"></div>

        <!-- Main Foreground Image -->
        <img 
          src={itemImage} 
          alt={item.image_alt || item.title_km}
          onerror="this.onerror=null; this.src='/images/blog_01_inline_khmer.webp';"
          class="w-full h-full object-cover object-center relative z-2 drop-shadow-md"
        />
      </div>

      <!-- ELEGANT EDITORIAL ARTICLE CARD CONTAINER (Matching user screenshot) -->
      <article class="bg-white rounded-sm border border-slate-200/90 p-8 md:p-14 shadow-sm relative overflow-hidden">
        
        <!-- Watermark Quote Icon in Top Right -->
        <Quote class="w-20 h-20 text-slate-100 absolute top-6 right-6 pointer-events-none rotate-180" />

        <!-- Executive Summary Section -->
        <div class="relative z-10 mb-10">
          <h2 class="text-xs font-bold text-champagne-dark font-mono uppercase mb-4 block">
            សង្ខេបប្រតិបត្តិ
          </h2>
          <p class="text-slate-700 font-km-sans text-base md:text-lg leading-relaxed font-light">
            {item.summary_km}
          </p>
        </div>

        <!-- Full Feature Article Story (Pure Khmer Gourmet Content) -->
        {item.content_km && (
          <div class="relative z-10 mb-10 pt-6 border-t border-slate-100">
            <h2 class="text-xl md:text-2xl font-bold font-km-serif text-onyx mb-6">
              សិល្បៈ និងបទពិសោធន៍ចម្អិនអាហារ
            </h2>
            <div class="text-slate-700 font-km-sans text-base md:text-lg leading-relaxed font-light space-y-4">
              {(item.content_km || '').split(/\n+/).map((line: string) => line.trim()).filter((line: string) => line.length > 0).map((line: string) => {
                if (line.startsWith('###') || line.startsWith('##') || line.startsWith('#')) {
                  const headingText = line.replace(/^#+\s*/, '');
                  return (
                    <h3 class="text-lg md:text-xl font-bold font-km-serif text-onyx mt-8 mb-2 pt-3 border-b border-slate-100/80 pb-2 flex items-center gap-2">
                      <span class="w-1.5 h-4 bg-champagne-dark rounded-full shrink-0"></span>
                      <span>{headingText}</span>
                    </h3>
                  );
                }
                return <p class="leading-relaxed mb-4">{line}</p>;
              })}
            </div>
          </div>
        )}

        <!-- Key Takeaways Section (Light Luxury Pearl Card with Champagne Accent) -->
        {item.key_points_km && item.key_points_km.length > 0 && (
          <div class="bg-pearl/80 border border-champagne/30 rounded-sm p-6 md:p-8 relative z-10 my-8 shadow-2xs">
            <h2 class="text-lg md:text-xl font-bold font-km-serif text-onyx mb-4 pb-3 border-b border-champagne/20 flex items-center gap-2">
              <span>ចំណុចវិភាគសំខាន់ៗ</span>
            </h2>
            <ul class="space-y-3.5">
              {item.key_points_km.map((pt: string) => (
                <li class="flex items-start gap-3 text-sm md:text-base text-slate-800 font-km-sans leading-relaxed">
                  <span class="w-1.5 h-1.5 rounded-full bg-champagne-dark mt-2.5 shrink-0"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Original Source Attribution Card (100% Pure Khmer, 0 English) -->
        {item.source_link && item.source_link.startsWith('http') && (
          <div class="bg-pearl/80 border border-slate-200/90 rounded-sm p-5 relative z-10 my-8 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <Globe class="w-4 h-4 text-champagne-dark shrink-0" />
              <div class="text-xs font-km-sans">
                <span class="text-slate-500 block mb-0.5 font-bold">ប្រភពដើមអន្តរជាតិ:</span>
                <span class="font-bold text-onyx line-clamp-1">{item.source_title_en || item.title_km}</span>
              </div>
            </div>
            <a 
              href={item.source_link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-white hover:bg-onyx text-onyx hover:text-white border border-slate-300 hover:border-onyx px-4 py-2 rounded-sm text-xs font-bold font-km-sans transition-all shrink-0 shadow-2xs group/ext"
            >
              <span>អានអត្ថបទដើម</span>
              <ArrowUpRight class="w-3.5 h-3.5 text-champagne-dark group-hover/ext:text-champagne transition-colors" />
            </a>
          </div>
        )}

        <!-- Internal Links / Related Articles Section -->
        <div class="relative z-10 mb-10 pt-6 border-t border-slate-100">
          <h2 class="text-xl font-bold font-km-serif text-onyx mb-5 flex items-center gap-2">
            <BookOpen class="w-5 h-5 text-champagne-dark" />
            <span>អត្ថបទពាក់ព័ន្ធ</span>
          </h2>
          <ul class="space-y-3.5 border-l-2 border-champagne/40 pl-4">
            {relatedPosts.map(post => {
              const slug = post.id.replace(/\.mdx?$/, '');
              return (
                <li>
                  <a 
                    href={`/blog/${slug}/`}
                    class="text-sm md:text-base font-bold font-km-sans text-onyx hover:text-champagne-dark underline decoration-slate-300 hover:decoration-champagne-dark underline-offset-4 transition-all block leading-relaxed"
                  >
                    {post.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Horizontal Divider -->
        <div class="border-t border-slate-200/80 my-8"></div>

        <!-- Bottom Source Action Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
          <a 
            href="/pulse/"
            class="inline-flex items-center justify-center gap-2 bg-slate-50 hover:bg-slate-100 border border-slate-300 hover:border-champagne-dark text-onyx px-6 py-3 rounded-sm font-km-sans font-bold text-xs transition-all shadow-2xs shrink-0"
          >
            <span>មើលបច្ចុប្បន្នភាពទាំងអស់</span>
            <ArrowRight class="w-3.5 h-3.5 text-champagne-dark" />
          </a>
          <span class="text-xs text-slate-400 font-km-sans">
            — ព័ត៌មាន និងស្តង់ដារបដិសណ្ឋារកិច្ចអន្តរជាតិ
          </span>
        </div>

      </article>

      <!-- Bottom Navigation & Telegram Contact Bar -->
      <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row justify-between items-center gap-4">
        <a 
          href="/pulse/" 
          class="inline-flex items-center gap-2 text-xs font-bold font-km-sans text-slate-600 hover:text-onyx transition-colors duration-200 group"
        >
          <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
          <span>ត្រឡប់ទៅកាន់បញ្ជីព័ត៌មាន</span>
        </a>
        <a 
          href="https://t.me/CKMSam06" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-onyx hover:bg-slate-800 text-white px-5 py-2.5 rounded-sm font-km-sans font-bold text-xs transition-all shadow-md"
        >
          <Send class="w-3.5 h-3.5 text-champagne" />
          <span>ពិគ្រោះយោបល់តាម Telegram</span>
        </a>
      </div>

    </div>
  </div>
</Layout>


