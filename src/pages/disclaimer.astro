---
import Layout from "../layouts/Layout.astro";

const title = "ការបដិសេធការទទួលខុសត្រូវ | CKM";
const description = "ការបដិសេធការទទួលខុសត្រូវរបស់ ចេង គួងម៉េង។ ព័ត៌មានម៉ឺនុយ រូបភាព និងអត្ថបទស្វ័យប្រវត្តិនៅលើគេហទំព័រនេះជាព័ត៌មានយោង។ សូមជូនដំណឹងអំពីអាឡែស៊ីមកក្រុមការងារនៅពេលកក់។";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ទំព័រដើម",
      "item": "https://ckmkh.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "ការបដិសេធការទទួលខុសត្រូវ",
      "item": "https://ckmkh.com/disclaimer/"
    }
  ]
});
---

<Layout title={title} description={description} lang="km">
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema}></script>
  <div class="max-w-4xl mx-auto px-6 py-24 md:py-32 font-sans text-slate-300 leading-relaxed">
    <div class="mb-12 border-b border-slate-800 pb-8">
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-amber-500 mb-4 leading-tight">ការបដិសេធការទទួលខុសត្រូវ</h1>
      <p class="text-sm text-slate-500">កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាពចុងក្រោយ: ថ្ងៃទី 22 ខែសីហា ឆ្នាំ 2026</p>
    </div>

    <div class="space-y-10 text-sm md:text-base opacity-90">
      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 1. ភាពត្រឹមត្រូវនៃព័ត៌មាន
        </h2>
        <p>យើងខ្ញុំខិតខំរក្សាព័ត៌មាននៅលើគេហទំព័រនេះឱ្យបានត្រឹមត្រូវតាមដែលអាចធ្វើទៅបាន។ ទោះជាយ៉ាងណា ម៉ឺនុយ មុខម្ហូប គ្រឿងផ្សំតាមរដូវ និងតួលេខទាំងឡាយ អាចផ្លាស់ប្តូរដោយមិនបានជូនដំណឹងជាមុន។ ដូច្នេះ សូមកុំពឹងផ្អែកលើព័ត៌មាននៅលើគេហទំព័រនេះតែមួយសម្រាប់ការសម្រេចចិត្ត។ មុនពេលកក់សេវាកម្ម សូមបញ្ជាក់ជាមួយក្រុមការងាររបស់យើងដោយផ្ទាល់ជានិច្ច។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 2. រូបភាពនៅលើគេហទំព័រ
        </h2>
        <p>រូបភាពម្ហូប និងរូបភាពកម្មវិធីនៅផ្នែកសេវាកម្មរបស់គេហទំព័រនេះ បង្ហាញអំពីស្នាដៃកន្លងមក និងរបៀបរៀបចំតុរបស់យើងខ្ញុំ ហើយវាមានតួនាទីជាឧទាហរណ៍។ ចំណែករូបភាពនៅផ្នែក "បច្ចុប្បន្នភាព និងនិន្នាការម្ហូបការអន្តរជាតិ" (/pulse/) វិញ មិនមែនជាស្នាដៃរបស់ CKM Catering ទេ ប៉ុន្តែមកពីប្រភពខាងក្រៅដែលមានតំណភ្ជាប់នៅលើអត្ថបទនីមួយៗ។ មុខម្ហូបដែលបម្រើជូននៅក្នុងកម្មវិធីណាមួយ អាស្រ័យលើអ្វីដែលបានព្រមព្រៀងគ្នាជាមួយក្រុមការងារ និងអាស្រ័យលើគ្រឿងផ្សំដែលអាចរកបាននៅពេលនោះ។ ដូច្នេះ រូបរាង ចំនួន និងការរៀបចំជាក់ស្តែង អាចខុសពីរូបភាពដែលបង្ហាញនៅទីនេះ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 3. អាឡែស៊ី និងតម្រូវការអាហារពិសេស
        </h2>
        <p>នេះជាចំណុចសំខាន់បំផុតនៅលើទំព័រនេះ។ គេហទំព័រនេះមិនអាចរាយបញ្ជីសារធាតុបង្កអាឡែស៊ីសម្រាប់មុខម្ហូបនីមួយៗបានឡើយ ព្រោះម៉ឺនុយ និងគ្រឿងផ្សំត្រូវបានកំណត់ជាក់លាក់សម្រាប់កម្មវិធីនីមួយៗ។ ប្រសិនបើលោកអ្នក ឬភ្ញៀវរបស់លោកអ្នកមានការមិនត្រូវនឹងអាហារ (អាឡែស៊ី) មានតម្រូវការតាមសាសនា ឬមានការហាមឃាត់ផ្នែកអាហារូបត្ថម្ភណាមួយ សូមជូនដំណឹងមកក្រុមការងាររបស់យើងឱ្យបានច្បាស់លាស់តាំងពីពេលកក់សេវាកម្ម ដើម្បីឱ្យយើងខ្ញុំអាចពិភាក្សាជាមួយលោកអ្នកអំពីមុខម្ហូបដែលសមរម្យ។ សូមជម្រាបផងដែរថា ដោយសារគ្រឿងផ្សំច្រើនប្រភេទត្រូវបានប្រើប្រាស់ក្នុងការរៀបចំជាមួយគ្នា យើងខ្ញុំមិនអាចធានាថាមុខម្ហូបណាមួយគ្មានសារធាតុបង្កអាឡែស៊ីទាំងស្រុងនោះទេ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 4. ខ្លឹមសារដែលបង្កើតដោយប្រព័ន្ធស្វ័យប្រវត្តិ
        </h2>
        <p>ផ្នែក "បច្ចុប្បន្នភាព និងនិន្នាការម្ហូបការអន្តរជាតិ" (/pulse/) នៃគេហទំព័រនេះ ត្រូវបានបង្កើតឡើងដោយប្រព័ន្ធស្វ័យប្រវត្តិ។ ប្រព័ន្ធនេះយកឈ្មោះមុខម្ហូបពីប្លុករូបមន្តម្ហូបសាធារណៈខាងក្រៅធ្វើជាចំណុចចាប់ផ្តើម រួចប្រើប្រាស់គំរូភាសាបញ្ញាសិប្បនិម្មិតដើម្បីសរសេរអត្ថបទខ្មែរថ្មីអំពីមុខម្ហូបនោះ។ អត្ថបទដែលបានបង្ហោះមិនមែនជាការបកប្រែ ឬការសង្ខេបនៃអត្ថបទដើមឡើយ។ អត្ថបទនីមួយៗឆ្លងកាត់ការត្រួតពិនិត្យខ្លឹមសារដោយស្វ័យប្រវត្តិ មុនពេលត្រូវបានបង្ហោះ ប៉ុន្តែសូមជម្រាបឱ្យបានច្បាស់ថា វាត្រូវបានបង្ហោះឡើងដោយស្វ័យប្រវត្តិ ដោយគ្មានការត្រួតពិនិត្យដោយមនុស្សមុនពេលវាឡើងលើគេហទំព័រនោះទេ។ តំណភ្ជាប់ទៅប្រភពដើមត្រូវបានបង្ហាញនៅលើអត្ថបទនីមួយៗ។ ខ្លឹមសារទាំងនេះមានគោលបំណងជាចំណេះដឹងទូទៅតែប៉ុណ្ណោះ វាមិនមែនជាការណែនាំ វាមិនតំណាងឱ្យម៉ឺនុយ ឬរូបមន្តរបស់ CKM Catering ហើយវាក៏អាចមានកំហុសដែរ។ ប្រសិនបើលោកអ្នកឃើញកំហុសណាមួយ សូមជូនដំណឹងមកយើងខ្ញុំ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 5. គ្មានការណែនាំផ្នែកសុខភាព ឬវេជ្ជសាស្ត្រ
        </h2>
        <p>អត្ថបទ និងព័ត៌មានទាំងឡាយនៅលើគេហទំព័រនេះ មិនមែនជាការណែនាំផ្នែកសុខភាព អាហារូបត្ថម្ភ ឬវេជ្ជសាស្ត្រឡើយ។ សម្រាប់សំណួរទាក់ទងនឹងសុខភាព របបអាហារ ឬអាឡែស៊ី សូមពិគ្រោះជាមួយវេជ្ជបណ្ឌិត ឬអ្នកជំនាញដែលមានលក្ខណៈសម្បត្តិគ្រប់គ្រាន់។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 6. ហាងនំ តាំង ហួត
        </h2>
        <p>ទំព័រ "ហាងនំ តាំង ហួត" (/tanghuot/) បង្ហាញអំពីហាងនំដាច់ដោយឡែកមួយ ដែលមានស្លាកសញ្ញា ទីតាំង លេខទូរស័ព្ទ Telegram និងទំព័រ Facebook ផ្ទាល់ខ្លួន។ រាល់ការសាកសួរ និងការបញ្ជាទិញនំ ត្រូវធ្វើឡើងតាមរយៈព័ត៌មានទំនាក់ទំនងដែលបង្ហាញនៅលើទំព័រនោះដោយផ្ទាល់ មិនមែនតាមរយៈព័ត៌មានទំនាក់ទំនងរបស់សេវាកម្មម្ហូបការឡើយ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 7. ទំនាក់ទំនងមកកាន់យើងខ្ញុំ
        </h2>
        <p>ប្រសិនបើលោកអ្នកមានសំណួរ ឬកង្វល់ណាមួយទាក់ទងនឹងខ្លឹមសារនៅលើគេហទំព័រនេះ សូមទាក់ទងមកក្រុមការងាររបស់យើងផ្ទាល់តាមរយៈប្រព័ន្ធ Telegram ឬលេខទូរស័ព្ទដែលបានផ្តល់ជូននៅលើគេហទំព័រ។ សម្រាប់លក្ខខណ្ឌនៃការប្រើប្រាស់ សូមមើលទំព័រ <a href="/terms/" class="text-amber-500 hover:text-amber-400 underline underline-offset-4">លក្ខខណ្ឌនៃការប្រើប្រាស់</a> និងសម្រាប់ការគ្រប់គ្រងទិន្នន័យ សូមមើលទំព័រ <a href="/privacy/" class="text-amber-500 hover:text-amber-400 underline underline-offset-4">គោលការណ៍ឯកជនភាព</a>។</p>
      </section>
    </div>

    <div class="mt-16 pt-8 border-t border-slate-800 flex justify-center">
        <a href="/" class="text-amber-500 hover:text-amber-400 border border-amber-500/30 hover:border-amber-500/80 px-8 py-3 rounded-sm transition-all font-bold text-sm uppercase">ត្រឡប់ទៅទំព័រដើម</a>
    </div>
  </div>
</Layout>
