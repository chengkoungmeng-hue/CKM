---
import Layout from "../layouts/Layout.astro";

const title = "គោលការណ៍ឯកជនភាព | CKM";
const description = "គោលការណ៍ឯកជនភាព និងការការពារទិន្នន័យរបស់ ចេង គួងម៉េង។ គេហទំព័រនេះមិនដាក់ខូគីតាមដាន និងមិនប្រមូលព័ត៌មានផ្ទាល់ខ្លួនរបស់លោកអ្នកឡើយ។";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ទំព័រដើម",
      "item": "https://ckmkh.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "គោលការណ៍ឯកជនភាព",
      "item": "https://ckmkh.com/privacy/"
    }
  ]
});
---

<Layout title={title} description={description} lang="km">
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema}></script>
  <div class="max-w-4xl mx-auto px-6 py-24 md:py-32 font-sans text-slate-300 leading-relaxed">
    <div class="mb-12 border-b border-slate-800 pb-8">
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-amber-500 mb-4 leading-tight">គោលការណ៍ឯកជនភាព និងការការពារទិន្នន័យ</h1>
      <p class="text-sm text-slate-500">កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាពចុងក្រោយ: ថ្ងៃទី 22 ខែសីហា ឆ្នាំ 2026</p>
    </div>

    <div class="space-y-10 text-sm md:text-base opacity-90">
      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 1. ការប្រមូល និងប្រើប្រាស់ព័ត៌មាន
        </h2>
        <p>CKM Catering យើងគោរពសិទ្ធិឯកជនភាពរបស់អ្នក។ គេហទំព័រនេះជាគេហទំព័រព័ត៌មានឋិតិវន្ត ដែលគ្មានទម្រង់បំពេញព័ត៌មានសម្រាប់ដាក់ស្នើឡើយ ដូច្នេះយើងខ្ញុំមិនប្រមូល និងមិនរក្សាទុកឈ្មោះ លេខទូរស័ព្ទ ឬព័ត៌មានផ្ទាល់ខ្លួនណាមួយរបស់អ្នកតាមរយៈគេហទំព័រនេះទេ។ អ្វីដែលយើងខ្ញុំទទួលបានគឺត្រឹមតែស្ថិតិចូលមើលជាសរុប ដូចជាចំនួនអ្នកចូលមើលទំព័រ ប្រទេស ប្រភេទឧបករណ៍ និងប្រភេទនៃកម្មវិធីរុករក ដែលជាទិន្នន័យអនាមិក និងមិនអាចប្រើដើម្បីសម្គាល់អត្តសញ្ញាណបុគ្គលណាម្នាក់បានឡើយ។ ចំណែកអាសយដ្ឋាន IP របស់អ្នកវិញ ត្រូវបានដំណើរការនៅស្រទាប់បណ្តាញដោយអ្នកផ្តល់សេវាបង្ហោះគេហទំព័រ (Cloudflare) សម្រាប់ការបញ្ជូនទិន្នន័យ សុវត្ថិភាព និងការប៉ាន់ស្មានប្រទេសដោយប្រហាក់ប្រហែលដែលត្រូវបញ្ចូលទៅក្នុងស្ថិតិសរុបនៅផ្នែកទី 3 ហើយយើងខ្ញុំពុំមានការរក្សាទុកវាទេ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 2. ខូគី និងបច្ចេកវិទ្យាតាមដាន
        </h2>
        <p>គេហទំព័រនេះមិនបានដាក់ខូគីរបស់ខ្លួនទៅក្នុងកម្មវិធីរុករករបស់អ្នកឡើយ ហើយក៏មិនរក្សាទុកទិន្នន័យណាមួយនៅលើឧបករណ៍របស់អ្នកដែរ។ ដោយសារគ្មានអ្វីត្រូវបានរក្សាទុក ឬអានចេញពីឧបករណ៍របស់អ្នក យើងខ្ញុំពុំមានបដាអនុញ្ញាតខូគីនៅលើគេហទំព័រនេះទេ ព្រោះគ្មានការតាមដានណាមួយដែលត្រូវសុំការយល់ព្រមពីអ្នកនោះឡើយ។ ករណីលើកលែងតែមួយគត់គឺខូគីសុវត្ថិភាពចាំបាច់ (ឧទាហរណ៍ __cf_bm) ដែល Cloudflare ជាអ្នកផ្តល់សេវាបណ្តាញអាចដាក់នៅស្រទាប់បណ្តាញ ដើម្បីការពារគេហទំព័រពីចរាចរណ៍ស្វ័យប្រវត្តិ និងការវាយប្រហារ។ ខូគីប្រភេទនេះមានអាយុកាលខ្លី និងមិនត្រូវបានប្រើសម្រាប់ការវិភាគទីផ្សារ ការផ្សាយពាណិជ្ជកម្ម ឬការតាមដានឥរិយាបថអ្នកប្រើប្រាស់ឡើយ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 3. សេវាកម្មភាគីទីបី
        </h2>
        <p>ដើម្បីដឹងថាតើទំព័រណាខ្លះមានប្រយោជន៍សម្រាប់អ្នកទស្សនា យើងខ្ញុំប្រើប្រាស់តែ Cloudflare Web Analytics មួយប៉ុណ្ណោះ ដែលជាឧបករណ៍វិភាគចរាចរណ៍គ្មានខូគី។ វារាយការណ៍ជូនយើងខ្ញុំតែទិន្នន័យសរុប ដូចជាចំនួនអ្នកចូលមើលទំព័រ ប្រភពតំណភ្ជាប់ ប្រទេស ប្រភេទឧបករណ៍ និងល្បឿននៃការផ្ទុកទំព័រ។ វាមិនបង្កើតលេខសម្គាល់សម្រាប់អ្នកប្រើប្រាស់ម្នាក់ៗ មិនសម្គាល់អត្តសញ្ញាណផ្ទាល់ខ្លួន និងមិនតាមដានដំណើរការរបស់អ្នកឆ្លងកាត់គេហទំព័រផ្សេងទៀតឡើយ។ យើងខ្ញុំមិនប្រើប្រាស់ Google Analytics ឬឧបករណ៍ផ្សាយពាណិជ្ជកម្មណាមួយទេ។ យើងនឹងមិនលក់ទិន្នន័យផ្ទាល់ខ្លួនរបស់អ្នកទៅឱ្យស្ថាប័នពាណិជ្ជកម្មផ្សេងៗនោះទេ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 4. ទំនាក់ទំនងមកកាន់យើងខ្ញុំ
        </h2>
        <p>ប្រសិនបើអ្នកមានសំណួរ ឬកង្វល់ណាមួយទាក់ទងនឹងគោលការណ៍ឯកជនភាពនេះ សូមទាក់ទងមកក្រុមការងាររបស់យើងផ្ទាល់តាមរយៈប្រព័ន្ធ Telegram ឬលេខទូរស័ព្ទដែលបានផ្តល់ជូននៅលើគេហទំព័រ។ សូមជម្រាបថាការសន្ទនាតាមរយៈ Telegram ឬទូរស័ព្ទកើតឡើងនៅក្រៅគេហទំព័រនេះ ហើយស្ថិតនៅក្រោមគោលការណ៍ឯកជនភាពរបស់ប្រតិបត្តិករសេវាទាំងនោះ។ ព័ត៌មានដែលអ្នកផ្តល់ជូនយើងខ្ញុំដោយផ្ទាល់ក្នុងពេលកក់សេវាកម្ម ដូចជាឈ្មោះ លេខទូរស័ព្ទ កាលបរិច្ឆេទ និងទីតាំងនៃកម្មវិធី ត្រូវបានរក្សាទុកដោយក្រុមការងាររបស់យើងតែសម្រាប់ការរៀបចំសេវាកម្មជូនអ្នកប៉ុណ្ណោះ ហើយមិនត្រូវបានបញ្ចូលទៅក្នុងគេហទំព័រនេះឡើយ។</p>
      </section>
    </div>
    
    <div class="mt-16 pt-8 border-t border-slate-800 flex justify-center">
        <a href="/" class="text-amber-500 hover:text-amber-400 border border-amber-500/30 hover:border-amber-500/80 px-8 py-3 rounded-sm transition-all font-bold text-sm uppercase">ត្រឡប់ទៅទំព័រដើម</a>
    </div>
  </div>
</Layout>
