---
import Layout from "../layouts/Layout.astro";

const title = "គោលការណ៍ឯកជនភាព | CKM";
const description = "គោលការណ៍ឯកជនភាព និងការការពារទិន្នន័យរបស់ ចេង គួងម៉េង។ យើងខ្ញុំពន្យល់ពីរបៀបដែលព័ត៌មានផ្ទាល់ខ្លួនរបស់លោកអ្នកត្រូវបានប្រើប្រាស់។";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ទំព័រដើម",
      "item": "https://ckmkh.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "គោលការណ៍ឯកជនភាព",
      "item": "https://ckmkh.com/privacy/"
    }
  ]
});
---

<Layout title={title} description={description} lang="km">
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema}></script>
  <div class="max-w-4xl mx-auto px-6 py-24 md:py-32 font-sans text-slate-300 leading-relaxed">
    <div class="mb-12 border-b border-slate-800 pb-8">
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-amber-500 mb-4 leading-tight">គោលការណ៍ឯកជនភាព និងការការពារទិន្នន័យ</h1>
      <p class="text-sm text-slate-500">កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាពចុងក្រោយ: ខែមេសា ឆ្នាំ 2026</p>
    </div>

    <div class="space-y-10 text-sm md:text-base opacity-90">
      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 1. ការប្រមូល និងប្រើប្រាស់ព័ត៌មាន
        </h2>
        <p>CKM Catering យើងគោរពសិទ្ធិឯកជនភាពរបស់អ្នក។ ព័ត៌មានដែលយើងប្រមូលត្រូវបានប្រើប្រាស់យ៉ាងតឹងរ៉ឹងដើម្បីកែលម្អបទពិសោធន៍នៃការប្រើប្រាស់គេហទំព័ររបស់អ្នក វិភាគចរាចរណ៍ទិន្នន័យ និងផ្តល់ជូននូវសេវាកម្មម្ហូបការលំដាប់ខ្ពស់។ វារួមបញ្ចូលទាំងអាសយដ្ឋាន IP ប្រភេទនៃកម្មវិធីរុករករបស់អ្នក និងទិន្នន័យអនាមិកតាមរយៈបច្ចេកវិទ្យាខូគី។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 2. ខូគី និងបច្ចេកវិទ្យាតាមដាន
        </h2>
        <p>ដូចដែលបានបង្ហាញនៅលើបដាអនុញ្ញាតរបស់យើង គេហទំព័រនេះប្រើប្រាស់ខូគី ដើម្បីដំណើរការមុខងារសំខាន់ៗ និងដើម្បីដំណើរការវិភាគទិន្នន័យ។ ដោយចុចយល់ព្រមលើបដាខូគី អ្នកអនុញ្ញាតឱ្យមានការតាមដានទាំងនេះ។ អ្នកអាចដកសិទ្ធិយល់ព្រមរបស់អ្នកវិញនៅពេលណាក៏បាន ដោយការលុបខូគីចេញពីកម្មវិធីរុករករបស់អ្នក។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 3. សេវាកម្មភាគីទីបី
        </h2>
        <p>ដើម្បីកែលម្អគុណភាពសេវាកម្ម និងធ្វើឱ្យការផ្សព្វផ្សាយទីផ្សារកាន់តែប្រសើរ យើងអាចប្រើប្រាស់ឧបករណ៍ភាគីទីបី (ដូចជា Google Analytics ជាដើម)។ យើងរក្សាការសម្ងាត់ជូនអតិថិជនយ៉ាងតឹងរ៉ឹងបំផុត ហើយយើងនឹងមិនលក់ទិន្នន័យផ្ទាល់ខ្លួនរបស់អ្នកទៅឱ្យស្ថាប័នពាណិជ្ជកម្មផ្សេងៗនោះទេ។</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-3 flex items-center gap-2">
            <span class="text-amber-500">◆</span> 4. ទំនាក់ទំនងមកកាន់យើងខ្ញុំ
        </h2>
        <p>ប្រសិនបើអ្នកមានសំណួរ ឬកង្វល់ណាមួយទាក់ទងនឹងគោលការណ៍ឯកជនភាពនេះ សូមទាក់ទងមកក្រុមការងាររបស់យើងផ្ទាល់តាមរយៈប្រព័ន្ធ Telegram ឬលេខទូរស័ព្ទដែលបានផ្តល់ជូននៅលើគេហទំព័រ។</p>
      </section>
    </div>
    
    <div class="mt-16 pt-8 border-t border-slate-800 flex justify-center">
        <a href="/" class="text-amber-500 hover:text-amber-400 border border-amber-500/30 hover:border-amber-500/80 px-8 py-3 rounded-sm transition-all font-bold text-sm uppercase">ត្រឡប់ទៅទំព័រដើម</a>
    </div>
  </div>
</Layout>
