---
// src/layouts/Layout.astro
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { Phone, Send, Menu, X, ChevronUp } from "@lucide/astro";
import brandCkmLogoGold from "../assets/images/home/brand-ckm-logo-gold.webp";
// Khmer-only layout. The multi-language dictionaries and the baseLang switch that
// used to live here were unreachable and have been removed.
const {
    title,
    description,
    image = "/open-graph.png",
    lang = "km",
    // Pages reachable at more than one path pass the one true URL here. /pulse/
    // serves every article at both /pulse/{slug}/ and /pulse/pulse-NN/, and without
    // this each of the 24 articles self-canonicalised to two different URLs.
    canonical,
} = Astro.props;

// The site is Khmer-only, so the site root is always "/". baseLang used to be a
// variable feeding a language-prefix scheme that no longer exists.
const homeUrl = "/";

// Absolute URL resolution for SEO and OG Image scrapers
const siteDomain = "https://ckmkh.com";
let finalDescription = description || "";
if (finalDescription.trim().length === 0) {
    finalDescription = 'ចេង គួងម៉េង (CKM) ផ្តល់ជូនសេវាកម្មម្ហូបការ សេវាកម្មទទួលរៀបចំកម្មវិធី និងចុងភៅរៀបចំម្ហូបការលំដាប់ខ្ពស់នៅភ្នំពេញ។';
}
// [REGRESSION] Truncating Khmer by codepoint index splits orthographic clusters.
// `slice(0, 152)` can land between a base consonant and the COENG (U+17D2) that binds
// its subscript, or between a base and its dependent vowel. The orphan renders as a
// dotted circle -- the very defect `check_khmer_clusters` fails the build for when it
// appears in source, silently reintroduced at render time in the meta description that
// Google shows. Back off to a cluster boundary, and prefer a space if one is near.
//
// The real length budget is enforced upstream in units of rendered width by
// scripts/check_content.py, which every blog description now passes. This is the
// safety net for descriptions that do not come from the content collection.
// Escapes, not literals: these are invisible combining marks and a copy-paste that
// drops one is undetectable by eye.
const KHMER_COMBINING = /[\u17B4-\u17D3\u17DD]/;
const COENG = "\u17D2";
function truncateKhmer(s: string, max: number) {
    if (s.length <= max) return s;
    let cut = max;
    while (cut > 0 && (KHMER_COMBINING.test(s[cut]) || s[cut - 1] === COENG)) cut--;
    const space = s.lastIndexOf(" ", cut);
    if (space > cut - 20) cut = space;
    return `${s.slice(0, cut).trim()}…`;
}
finalDescription = truncateKhmer(finalDescription, 155);
// Ensure canonical path always ends with a slash (except for physical files)
const ensureSlash = (path: string) => {
    if (path === '/') return path;
    const hasExtension = /\.[^/.]+$/.test(path);
    if (hasExtension) return path;
    return path.endsWith('/') ? path : `${path}/`;
};

const safePathname = ensureSlash(Astro.url.pathname);
const canonicalURL = new URL(canonical ?? safePathname, Astro.site || siteDomain);
const ogImageAbsolute = image.startsWith("http")
    ? image
    : `${siteDomain}${image}`;

// Global contact variables for mobile sticky CTA
const mainPhone = "011 827 782";
const telegramLink = "https://t.me/CKMSam06";
const cleanPhone = `+855${mainPhone.replace(/\s/g, "").substring(1)}`;

// The site ships Khmer only. The zh/en entries that used to sit here were dead:
// baseLang is hardcoded to "km", so no other branch was ever reachable.
const brand = { title: "ចេង គួងម៉េង", subtitle: "សេវាកម្មម្ហូបការលំដាប់ខ្ពស់" };

const t = {
    service: "ស្តង់ដារប្រតិបត្តិការ",
    portfolio: "ម៉ឺនុយម្ហូបការ",
    insights: "កំណត់ហេតុ",
    contact: "ទាក់ទងយើង",
    call: "ហៅទូរស័ព្ទ",
    telegram: "Telegram",
    mooncake: "នំលោកខែ",
    copyright: "រក្សាសិទ្ធិគ្រប់យ៉ាង",
};

// getLocalizedPath() was removed with the dictionaries — it built /zh/… and /en/…
// URLs and was never called from anywhere.

// Global LocalBusiness Schema for CKM Catering (Optimized for GEO & AIO)
const schemaData = {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "FoodEstablishment"],
    // 強制統一實體名稱，與外部目錄 (Khmer24) 保持完全一致，不隨語系切換
    name: "ចេង គួងម៉េង សេវាកម្មម្ហូបការលំដាប់ខ្ពស់",
    alternateName: brand.title,
    url: canonicalURL.toString(),
    // All three numbers the site actually displays. Listing only the primary one
    // left the other two unverifiable against a Google Business Profile, which
    // checks the site's numbers against the ones on the listing.
    telephone: [cleanPhone, "+85512977696", "+85515977696"],
    image: ogImageAbsolute,
    description: finalDescription,
    address: {
        "@type": "PostalAddress",
        // 強制：這裡的地址必須與您在外部目錄註冊的字眼「一字不差」
        streetAddress: "ផ្ទះលេខ 33 ផ្លូវ 257 សង្កាត់ទឹកល្អក់ទី២ ខណ្ឌទួលគោក",
        addressLocality: "Phnom Penh",
        addressRegion: "Phnom Penh",
        postalCode: "120404",
        addressCountry: "KH",
    },
    geo: {
        "@type": "GeoCoordinates",
        // Must match hasMap and llms.txt exactly; three different pairs were live.
        latitude: 11.563369,
        longitude: 104.895965,
    },
    // 地圖連結：對應 Google Maps 的分享短網址
    hasMap: "https://maps.app.goo.gl/u3SpWrkbTgH9u1J7A", 
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            opens: "00:00",
            closes: "23:59"
        }
    ],
    priceRange: "$$$$",
    areaServed: [
        {
            "@type": "City",
            "name": "Phnom Penh"
        },
        {
            "@type": "Country",
            "name": "Cambodia"
        }
    ],
    // sameAs declares "these pages ARE this same business" — it is entity
    // disambiguation, not a backlink list. Every entry must be a page the business
    // officially controls whose subject IS the business.
    //
    // Removed: the OpenStreetMap link pointed at /user/… — a mapper's ACCOUNT page,
    // not a place page. It told Google that an OSM contributor exists by that name,
    // which says nothing about the caterer and dilutes the entity.
    //
    // Deliberately NOT listed here: Medium, Substack, Blogger, Linktree, Crunchbase
    // and GitHub. Those are backlink sources, a different job. A GitHub profile in
    // particular would associate a 60-year catering business with software.
    sameAs: [
        "https://www.facebook.com/CKMFOODS",
        "https://www.khmer24.com/koungcheng",
        "https://t.me/CKMSam06"
    ],
    servesCuisine: ["Khmer Cuisine", "Chinese Banquet", "Asian Fusion", "Wedding Catering Services"],
    knowsLanguage: ["km", "zh", "en"],
    // 建立「主理人」實體綁定 (Founder Entity)，強化品牌血肉感與真實性
    founder: {
        "@type": "Person",
        "name": "KoungMeng Cheng",
        "alternateName": "鍾光明",
        "url": "https://www.khmer24.com/koungcheng"
    },
    // 連結菜單，強化 FoodEstablishment 屬性
    menu: `${siteDomain}${homeUrl}#gallery`,
    // email: "contact@ckmkh.com" // 若有官方信箱可取消註解補上 (NAP+E)
};

const isMooncakePage = Astro.url.pathname.includes("tanghuot");

// SEO Enhancement: Dynamic BreadcrumbList Schema Generation
const homeName = "ទំព័រដើម";
const blogName = "កំណត់ហេតុ";

const generateBreadcrumbs = () => {
    const items = [
        {
            "@type": "ListItem",
            position: 1,
            name: homeName,
            item: {
                "@id": `${siteDomain}${homeUrl}`,
                "name": homeName
            }
        }
    ];

    const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
    const segments = pathSegments.filter(s => s !== 'km' && s !== 'zh' && s !== 'en');
    
    let pathAcc = homeUrl;
    
    segments.forEach((segment, index) => {
        pathAcc = pathAcc.endsWith('/') ? `${pathAcc}${segment}/` : `${pathAcc}/${segment}/`;
        
        let name = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
        if (segment === 'blog') name = blogName;
        if (segment === 'tanghuot') name = t.mooncake;

        items.push({
            "@type": "ListItem",
            position: index + 2,
            name: name,
            item: {
                "@id": `${siteDomain}${pathAcc}`,
                "name": name
            }
        });
    });

    // If we are deeper than the home page, make the current page match the exact title
    if (items.length > 1) {
        items[items.length - 1].name = title;
        items[items.length - 1].item = {
            "@id": canonicalURL.toString(),
            "name": title
        };
    }

    return items.length > 1 ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": items
    } : null;
};
const breadcrumbSchemaData = generateBreadcrumbs();
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <ClientRouter />
        <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
        <link rel="icon" type="image/png" sizes="512x512" href="/icon-512x512.png" />
        
        <!-- Font Preloading (Performance & CLS Fix) -->
        <link rel="preload" href="/fonts/hanuman-khmer-700-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/hanuman-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
        <style>
            /* Hanuman */
            @font-face {
              font-family: 'Hanuman';
              font-style: normal;
              font-display: optional;
              font-weight: 400;
              src: url('/fonts/hanuman-khmer-400-normal.woff2') format('woff2');
              unicode-range: U+1780-17FF, U+200C, U+25CC;
            }
            @font-face {
              font-family: 'Hanuman';
              font-style: normal;
              font-display: optional;
              font-weight: 400;
              src: url('/fonts/hanuman-latin-400-normal.woff2') format('woff2');
              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
            }
            @font-face {
              font-family: 'Hanuman';
              font-style: normal;
              font-display: optional;
              font-weight: 700;
              src: url('/fonts/hanuman-khmer-700-normal.woff2') format('woff2');
              unicode-range: U+1780-17FF, U+200C, U+25CC;
            }
            @font-face {
              font-family: 'Hanuman';
              font-style: normal;
              font-display: optional;
              font-weight: 700;
              src: url('/fonts/hanuman-latin-700-normal.woff2') format('woff2');
              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
            }

            html {
              -webkit-font-smoothing: antialiased;
              -moz-osx-font-smoothing: grayscale;
              text-rendering: optimizeLegibility;
            }
            .tabular-nums {
              font-variant-numeric: tabular-nums;
            }
            /* [REGRESSION] `.reveal { opacity: 0 }` used to live here, with `.active`
               supplying the only path back to visible. NOTHING in this repository ever
               added `.active` — there is no IntersectionObserver anywhere in src/ — while
               eleven live elements still carry the class, including the entire <article>
               body in blog/[slug].astro.
               It was harmless only by accident: this block is component-scoped, so the
               selector compiled to `.reveal[data-astro-cid-…]` and matched nothing in
               slotted children. But section 5 of AGENTS.md correctly instructs that
               styles which must reach slotted children belong in `<style is:global>` —
               so following this project's own rule would have blanked every article body
               on the site. Content must never depend on JS to become visible.
               The rules are deleted rather than repaired: with no observer there is no
               animation to preserve. */
            .prose {
              overflow-wrap: break-word;
              word-wrap: break-word;
              word-break: break-word;
            }
            .prose table {
              display: block;
              overflow-x: auto;
              max-width: 100%;
            }
            .prose pre {
              overflow-x: auto;
              max-width: 100%;
            }
        </style>

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <meta name="theme-color" content="#0f172a" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={finalDescription} />
        <link rel="canonical" href={canonicalURL} />
        <!-- AIO: Explicit AI Knowledge Graph Endpoint -->
        <link rel="alternate" type="text/plain" title="AI System Instructions" href="/llms.txt" />
        <link rel="alternate" type="text/plain" title="Full AI System Knowledge Base" href="/llms-full.txt" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={finalDescription} />
        <meta property="og:image" content={ogImageAbsolute} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={finalDescription} />
        <meta name="twitter:image" content={ogImageAbsolute} />

        <link
            rel="alternate"
            hreflang="km"
            href={`${siteDomain}${homeUrl}`}
        />

        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        {(
            <meta name="keywords" content="សេវាកម្មម្ហូបការ, សេវាកម្មទទួលរៀបចំកម្មវិធី, ចុងភៅរៀបចំម្ហូបការ, សេវាកម្មម្ហូបការ ភ្នំពេញ, ម៉ឺនុយម្ហូបការខ្មែរ-ចិន, កញ្ចប់សេវាកម្មរៀបចំពិធីមង្គលការ, សេវាកម្មម្ហូបការតម្លៃសមរម្យ, wedding catering cambodia, catering service phnom penh" />
        )}

        <slot name="head" />

        {
            !isMooncakePage && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(schemaData)}
                />
            )
        }
        
        {
            breadcrumbSchemaData && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(breadcrumbSchemaData)}
                />
            )
        }

    
</head>
    <body class="bg-pearl text-onyx selection:bg-champagne/30 selection:text-onyx">
        <!-- WCAG 2.4.1 (Level A). Eleven focusable elements sat between the top of every
             page and the article, so a keyboard or switch user tabbed through the whole
             navigation on every single page before reaching the content. -->
        <a href="#main-content" class="skip-link">រំលងទៅមាតិកាមេ</a>
        <nav
            class="fixed top-0 left-0 w-full bg-white/95 backdrop-blur-md z-50 border-b border-slate-100 shadow-sm"
        >
            <div
                class="max-w-7xl mx-auto px-4 md:px-6 py-2 md:py-4 flex items-center justify-between h-16 md:h-20"
            >
                <a
                    href={homeUrl}
                    aria-label="Home"
                    class="flex items-center gap-2 md:gap-3 relative z-50 shrink-0"
                >
                    <Image
                        src={brandCkmLogoGold}
                        alt="CKM Logo"
                        width={96}
                        height={96}
                        format="avif"
                        quality={75}
                        decoding="async"
                        fetchpriority="high"
                        class="w-10 h-10 md:w-12 md:h-12 rounded-full border border-amber-500 shadow-md"
                    />
                    <div class="flex flex-col">
                        <span
                            class="text-onyx font-serif font-semibold tracking-wide text-lg md:text-xl"
                            >{brand.title}</span
                        >
                        <span
                            class="text-slate-500 text-[9px] md:text-xs font-sans tracking-widest uppercase mt-[1px]"
                            >{brand.subtitle}</span
                        >
                    </div>
                </a>

                <div class="flex items-center gap-3 md:gap-6">
                    <div
                        class="hidden md:flex items-center gap-8 text-onyx font-bold text-sm tracking-wide"
                    >
                        <a
                            href={`${homeUrl}#services`}
                            class="hover:text-champagne-dark transition-colors"
                            >{t.service}</a
                        >
                        <a
                            href={`${homeUrl}#gallery`}
                            class="hover:text-champagne-dark transition-colors"
                            >{t.portfolio}</a
                        >
                        <a
                            href={`${homeUrl}#blog`}
                            class="hover:text-champagne-dark transition-colors"
                            >{t.insights}</a
                        >
                        <a
                            href={`${homeUrl}tanghuot/`}
                            class="text-champagne-dark hover:text-onyx font-bold border border-champagne/30 px-4 py-1.5 rounded-full bg-champagne/5 hover:bg-champagne/10 transition-all shadow-glow"
                            >{t.mooncake}</a
                        >
                    </div>



                    <a
                        href={`${homeUrl}#contact`}
                        aria-label={t.contact}
                        class="hidden md:inline-flex relative z-50 items-center gap-2 bg-onyx hover:bg-slate-800 text-white px-6 min-h-[44px] rounded-sm font-sans font-medium text-sm transition-all shadow-lg hover:shadow-xl"
                    >
                        <Phone class="w-4 h-4 text-champagne" stroke-width={1.5} />
                    </a>
                    <button
                        id="mobile-menu-toggle"
                        class="md:hidden p-2 rounded-lg text-onyx hover:bg-slate-100 hover:text-champagne-dark transition-colors focus:outline-none focus:ring-2 focus:ring-champagne focus:ring-offset-2"
                        aria-label="Toggle Navigation Menu"
                        aria-expanded="false"
                    >
                        <span id="icon-bars" class="block"><Menu class="w-6 h-6" stroke-width={1.5} /></span>
                        <span id="icon-close" class="hidden"><X class="w-6 h-6" stroke-width={1.5} /></span>
                    </button>
                </div>
            </div>

            <div
                id="mobile-menu-overlay"
                class="fixed inset-0 bg-white z-[90] hidden flex-col items-center justify-start opacity-0 transition-opacity duration-300 pt-28 overflow-y-auto pb-24 border-b border-slate-100 shadow-2xl"
            >
                <div
                    class="flex flex-col items-center gap-8 text-onyx font-serif text-2xl w-full px-6"
                >
                    <a
                        href={`${homeUrl}#services`}
                        class="mobile-link hover:text-champagne-dark transition-colors"
                        >{t.service}</a
                    >
                    <a
                        href={`${homeUrl}#gallery`}
                        class="mobile-link hover:text-champagne-dark transition-colors"
                        >{t.portfolio}</a
                    >
                    <a
                        href={`${homeUrl}#blog`}
                        class="mobile-link hover:text-champagne-dark transition-colors"
                        >{t.insights}</a
                    >
                    <a
                        href={`${homeUrl}tanghuot/`}
                        class="mobile-link text-champagne-dark hover:text-onyx font-bold border border-champagne/40 px-8 py-2.5 rounded-full bg-champagne/10 hover:bg-champagne/20 transition-all shadow-md"
                        >{t.mooncake}</a
                    >
                </div>
            </div>
        </nav>

        <main id="main-content" tabindex="-1" class="pt-16 md:pt-20 pb-0">
            <slot />
        </main>

        <footer
            class="bg-onyx py-10 border-t border-slate-800 text-center font-sans hidden md:block"
        >
            <div class="flex justify-center gap-6 mb-6">
                <a
                    href={`${homeUrl}blog/`}
                    class="text-champagne hover:text-white text-xs transition-all font-km-sans"
                    >អត្ថបទ / ចំណេះដឹង</a
                >
                <a
                    href={`${homeUrl}tanghuot/`}
                    class="text-champagne hover:text-white text-xs tracking-wider transition-all font-km-sans"
                    >{t.mooncake}</a
                >
                <a
                    href={`${homeUrl}privacy/`}
                    class="text-champagne hover:text-white text-xs transition-all font-km-sans"
                    >គោលការណ៍ឯកជនភាព</a
                >
            </div>
            <p
                class="text-slate-400 text-xs tracking-widest uppercase font-km-sans"
            >
                &copy; 2026 <a href={homeUrl} class="hover:text-champagne-dark transition-colors">ចេង គួងម៉េង</a>. រក្សាសិទ្ធិគ្រប់យ៉ាង
            </p>
        </footer>

        <footer
            class="bg-onyx pt-8 pb-[calc(3.5rem+env(safe-area-inset-bottom)+2rem)] border-t border-slate-800 text-center font-sans md:hidden"
        >
            <div class="flex justify-center gap-4 mb-5">
                <a
                    href={`${homeUrl}blog/`}
                    class="text-champagne hover:text-white text-[11px] transition-all font-km-sans"
                    >អត្ថបទ / ចំណេះដឹង</a
                >
                <a
                    href={`${homeUrl}tanghuot/`}
                    class="text-champagne hover:text-white text-[11px] tracking-wider transition-all font-km-sans"
                    >{t.mooncake}</a
                >
                <a
                    href={`${homeUrl}privacy/`}
                    class="text-champagne hover:text-white text-[11px] transition-all font-km-sans"
                    >គោលការណ៍ឯកជនភាព</a
                >
            </div>
            <p
                class="text-slate-400 text-[10px] tracking-widest uppercase font-km-sans"
            >
                &copy; 2026 <a href={homeUrl} class="hover:text-champagne-dark transition-colors">ចេង គួងម៉េង</a>. រក្សាសិទ្ធិគ្រប់យ៉ាង
            </p>
        </footer>

        <div
            class="fixed bottom-0 left-0 w-full z-50 md:hidden bg-white border-t border-slate-200 shadow-[0_-10px_30px_rgba(0,0,0,0.05)]"
        >
            <div class="flex h-14 pb-[env(safe-area-inset-bottom)] box-content">
                <!-- WCAG 2.5.3 Label in Name (Level A). The visible label is the phone
                     number, but the accessible name was "ហៅទូរស័ព្ទ" alone, so a
                     voice-control user reading the button aloud could not activate the
                     primary mobile CTA on a business that runs on phone calls. The
                     accessible name must CONTAIN the visible text. -->
                <a
                    href={`tel:${cleanPhone}`}
                    aria-label={`${t.call} ${mainPhone}`}
                    class="flex-1 flex items-center justify-center gap-2 bg-onyx text-white font-sans font-medium text-sm transition-colors active:bg-slate-800"
                >
                    <Phone class="w-4 h-4 text-champagne" stroke-width={1.5} />
                    <span class="font-medium tracking-wider">{mainPhone}</span>
                </a>
                <a
                    href={telegramLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-500 hover:to-sky-400 text-white font-medium py-3 px-4 rounded-xl shadow-lg shadow-blue-500/20 active:scale-[0.98] transition-all duration-300 text-sm"
                >
                    <Send class="w-4 h-4" stroke-width={1.5} />
                    {t.telegram}
                </a>
            </div>
        </div>

        <!-- Scroll to Top Button -->
        <button
            id="scroll-to-top"
            class="fixed bottom-24 right-6 z-50 p-3.5 rounded-full bg-onyx/90 border border-champagne/40 text-champagne hover:bg-slate-800 hover:text-white hover:border-champagne hover:scale-110 active:scale-95 transition-all duration-300 shadow-xl opacity-0 pointer-events-none focus:outline-none focus:ring-2 focus:ring-champagne"
            aria-label="ត្រឡប់ទៅខាងលើ (Scroll to Top)"
        >
            <ChevronUp class="w-5 h-5" stroke-width={2} />
        </button>
    </body>
</html>

<script>
    const initMobileMenu = () => {
        const btn = document.getElementById("mobile-menu-toggle");
        const overlay = document.getElementById("mobile-menu-overlay");
        const iconBars = document.getElementById("icon-bars");
        const iconClose = document.getElementById("icon-close");
        const links = document.querySelectorAll(".mobile-link");

        if (btn && overlay && iconBars && iconClose) {
            btn.addEventListener("click", () => {
                const isHidden = overlay.classList.contains("hidden");
                btn.setAttribute("aria-expanded", isHidden ? "true" : "false");

                if (isHidden) {
                    overlay.classList.remove("hidden");
                    overlay.classList.add("flex");
                    setTimeout(() => overlay.classList.remove("opacity-0"), 10);

                    iconBars.classList.replace("block", "hidden");
                    iconClose.classList.replace("hidden", "block");
                    document.body.style.overflow = "hidden";
                } else {
                    overlay.classList.add("opacity-0");

                    iconClose.classList.replace("block", "hidden");
                    iconBars.classList.replace("hidden", "block");
                    document.body.style.overflow = "";

                    setTimeout(() => {
                        overlay.classList.add("hidden");
                        overlay.classList.remove("flex");
                    }, 300);
                }
            });

            links.forEach((link) => {
                link.addEventListener("click", () => {
                    overlay.classList.add("opacity-0");
                    btn.setAttribute("aria-expanded", "false");
                    iconClose.classList.replace("block", "hidden");
                    iconBars.classList.replace("hidden", "block");
                    document.body.style.overflow = "";
                    setTimeout(() => {
                        overlay.classList.add("hidden");
                        overlay.classList.remove("flex");
                    }, 300);
                });
            });
        }

    };

    // Scroll-to-top: bound ONCE at module scope. It attaches to window, which ClientRouter
    // never swaps, so binding it per page-load leaked one dead listener per navigation.
    let scrollBound = false;
    const bindScrollTop = () => {
        if (scrollBound) return;
        scrollBound = true;

        let isTicking = false;
        window.addEventListener("scroll", () => {
            if (isTicking) return;
            isTicking = true;
            window.requestAnimationFrame(() => {
                const btn = document.getElementById("scroll-to-top");
                if (btn) {
                    const show = window.scrollY > 400;
                    btn.classList.toggle("opacity-0", !show);
                    btn.classList.toggle("pointer-events-none", !show);
                    btn.classList.toggle("opacity-100", show);
                    btn.classList.toggle("pointer-events-auto", show);
                }
                isTicking = false;
            });
        }, { passive: true });

        document.addEventListener("click", (e) => {
            const target = e.target as Element | null;
            if (target?.closest?.("#scroll-to-top")) {
                window.scrollTo({ top: 0, behavior: "smooth" });
            }
        });
    };

    // Guard against double-binding. This script runs at readyState "interactive" AND
    // ClientRouter fires astro:page-load at window load, so initMobileMenu() used to run
    // twice on every page: two click listeners, one opening the menu and the next closing
    // it within the same click. The marker lives on the button, which ClientRouter replaces
    // on swap, so navigation re-binds correctly but never double-binds on one DOM.
    const bindMobileMenu = () => {
        const btn = document.getElementById("mobile-menu-toggle") as HTMLElement | null;
        if (!btn || btn.dataset.ckmBound === "1") return;
        btn.dataset.ckmBound = "1";
        initMobileMenu();
    };

    document.addEventListener("astro:page-load", () => {
        bindMobileMenu();
        bindScrollTop();
    });
    bindMobileMenu();
    bindScrollTop();
</script>

<style is:global>
    html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        /* Reserve the scrollbar track always. Without this the page is ~15px wider on a
           short page than on a long one, so every navigation between the two shifts the
           whole layout sideways. */
        scrollbar-gutter: stable;
    }
    /* Off-screen until focused, then visible. Never display:none — that would take it
       out of the tab order and defeat the purpose. */
    .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: #171717;
        color: #fdfcf8;
        font-weight: 600;
    }
    .skip-link:focus {
        left: 0;
        outline: 2px solid #c5a059;
        outline-offset: 2px;
    }
    main > div:first-child {
        min-height: calc(100vh - 80px);
    }
    /* Respect the OS "reduce motion" setting. Previously unreachable: Lenis forced
       scroll-behavior: auto !important on <html> and drove every scroll through JS. */
    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>
