---
import { Image } from 'astro:assets';

// Declared here rather than extending a BlogPost type from homeData: that type
// does not exist there, so every field it was meant to supply -- title,
// subTitle, link, image -- resolved to nothing and astro check reported five
// errors on this file. The shape below is what formatPost() in
// src/pages/blog/index.astro actually passes.
interface Props {
  title: string;
  subTitle: string;
  link: string;
  image: ImageMetadata;
  category?: string;
  titleClass: string;
  subTitleClass: string;
  linkClass: string;
  linkLabel: string;
}

const { title, subTitle, link, image, titleClass, subTitleClass, linkClass, linkLabel } = Astro.props;
---
<a href={link} class="group block bg-white rounded-sm overflow-hidden shadow-sm hover:shadow-glow-lg transition-all duration-500 border border-slate-100 hover:border-champagne/30 flex flex-col h-full">
    <div class="block aspect-[16/9] overflow-hidden relative bg-slate-200">
      <Image src={image} alt={title} width={1200} height={360} widths={[300, 510, 640]} sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw" format="avif" quality={50} decoding="async" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-700"/>
    </div>
    <div class="p-6 md:p-8 flex flex-col flex-grow">
      <h3 class={titleClass}>{title}</h3>
      <p class={subTitleClass}>{subTitle}</p>
      
      <div aria-label={`${linkLabel}: ${title}`} class={linkClass}>
          {linkLabel}
          <slot name="link-icon" />
      </div>
    </div>
</a>
