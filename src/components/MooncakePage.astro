---
import { Image } from "astro:assets";
import imgLogo29 from '../assets/images/tanghuot/nom-lok-khae-logo-image_29.webp';
import imgLogoTanghout from '../assets/images/tanghuot/logo-tanghout.webp';
import imgHeroStone from '../assets/images/tanghuot/hero-abstract-angkor-stone.webp';
import imgProducts from '../assets/images/tanghuot/nom-products-tang-huot.webp';
import imgSlice from '../assets/images/tanghuot/nom-lok-khae-slice-image_2.webp';
import imgCholChnam from '../assets/images/tanghuot/nom-chol-chnam-image_20_generated.webp';
import imgSteamer from '../assets/images/tanghuot/hero-steamer-tradition.webp';
import Layout from "../layouts/Layout.astro";
import { Phone, Award, Flame, Sunrise, Send, MapPin } from "@lucide/astro";






// The site ships Khmer only — /zh and /en are 301-redirected at the edge.
// The English and Chinese dictionaries that used to live here were unreachable:
// nothing ever passed lang="en" or lang="zh" to this component.
const t = {
  // Search intent leads, brand follows. Nobody types the shop's name — they type
  // the pastry and the city. The old title opened with "ហាងនំ តាំង ហួត" and buried
  // both, and "ភ្នំពេញ" appeared only twice in the whole page.
  seoTitle: "នំព្រះខែ នំពងទា ភ្នំពេញ | ហាងនំ តាំង ហួត បោះដុំ និងលក់រាយ",
  seoDesc: "ហាងនំគ្រួសារនៅភ្នំពេញ ធ្វើនំព្រះខែ នំពងទា និងនំហ្វាកាវ ដុតក្នុងរោងនំផ្ទាល់ខ្លួន។ ទទួលទាំងបោះដុំសម្រាប់ហាង និងលក់រាយសម្រាប់គ្រួសារ។ ទូរស័ព្ទ ០១២ ៦៧៧ ៧១០។",
  h1: "ហាងនំ តាំង ហួត",
  heroSub: "នំព្រះខែ នំពងទា និងនំប្រពៃណី",
  heroHighlight: "ទទួលបោះដុំ និងលក់រាយ",
  heroDesc: "ហាងនំ តាំង ហួត ជាហាងនំគ្រួសារនៅភ្នំពេញ ដែលធ្វើនំព្រះខែ នំពងទា និងនំហ្វាកាវ។ យើងដុតនំនៅរោងនំផ្ទាល់ខ្លួន ដូច្នេះអាចទទួលទាំងការបញ្ជាទិញបោះដុំសម្រាប់ហាង និងការទិញរាយសម្រាប់គ្រួសារ។ សូមទូរស័ព្ទមកសាកសួរ និងកក់ការបញ្ជាទិញ។",
  preorderTitle: "ទំនាក់ទំនងបោះដុំ និងលក់រាយ",
  sigTag: "នំប្រចាំហាង",
  sigTitle: "នំពងទា តាំង ហួត៖ រសជាតិដើម",
  sigDesc: "នំពងទា គឺជានំដែលយើងធ្វើគ្រប់ថ្ងៃពេញមួយឆ្នាំ។ សំបកនំមានជាន់ស្តើងៗ ហើយពងទានៅចំកណ្តាលទន់ល្មម មិនស្ងួត។ នេះជានំដែលអតិថិជនត្រឡប់មកទិញម្តងហើយម្តងទៀត។",
  mcTitle: "នំព្រះខែ សម្រាប់បុណ្យភ្ជុំខែ",
  mcDesc: "នំព្រះខែជានំប្រចាំរដូវរបស់យើង។ យើងដុតជាបាច់តូចៗពេញមួយថ្ងៃ ជាជាងដុតទាំងអស់ក្នុងពេលតែមួយ ដូច្នេះនំដែលដល់ដៃលោកអ្នកនៅថ្មី សាច់ខាងក្នុងទន់ និងសំបកមានពណ៌មាសស្មើគ្នា។ សម្រាប់ចំនួន និងកាលបរិច្ឆេទដែលលោកអ្នកត្រូវការ សូមទូរស័ព្ទមកសាកសួរដោយផ្ទាល់។",
  fagaoTitle: "នំហ្វាកាវ សម្រាប់ចូលឆ្នាំចិន",
  fagaoDesc1: "នៅពេលចូលឆ្នាំចិន យើងរៀបចំខ្លួនរួចរាល់ ដើម្បីផ្គត់ផ្គង់នំហ្វាកាវជូនអតិថិជនបោះដុំឱ្យបានគ្រប់គ្រាន់។",
  fagaoDesc2: "ការធ្វើនំហ្វាកាវទាមទារការលាយម្សៅ និងការមើលភ្លើងចំហុយឱ្យបានត្រឹមត្រូវ។ យើងតែងតែប្រុងប្រយ័ត្ន ដើម្បីឱ្យនំរាល់ដុំរីកបានស្អាត សម្រាប់ជាការជូនពរ និងសែនព្រេនក្នុងឆ្នាំថ្មី។",
  contactTitle: "ទំនាក់ទំនង",
  facilityTag: "ផលិតក្នុងរោងនំថ្មី",
  address: "ផ្ទះលេខ៤៥៤ ផ្លូវលំភូមិត្រពាំងថ្លឹង១ សង្កាត់ចោមចៅ ខណ្ឌពោធិ៍សែនជ័យ រាជធានីភ្នំពេញ",
};
---

{/* Without an explicit image this page inherited /open-graph.png — a CKM wedding
    banquet photo. Every share of the bakery in a Telegram or Facebook group showed
    catering, not pastry. /th-image.jpg is the shop's own shot: a 陳發-stamped mooncake
    beside the business card carrying both phone numbers, which is exactly what should
    appear in a chat group through the Mid-Autumn season. */}
<Layout title={t.seoTitle} description={t.seoDesc} lang="km-KH" image="/th-image.jpg">
  <Fragment slot="head">
    <link rel="icon" type="image/x-icon" href="/thicon.ico" />
    <!-- LCP preload removed in favor of Astro Image handling -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["WholesaleStore", "Bakery"],
        "name": t.h1,
        // "image" is declared once, further down, as the product shot plus the
        // logo. A second declaration lived here and was silently overridden by
        // that one -- JavaScript keeps the last, so the logo-only value never
        // reached the page and the duplicate only surfaced as a type error.
        "description": t.seoDesc,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": t.address,
          "addressLocality": "Phnom Penh",
          "addressRegion": "Phnom Penh",
          "addressCountry": "KH"
        },
        // Both numbers appear on the shop's card and in the contact section; the schema
        // listed only the Cellcard one, so the Smart number was invisible to Google.
        "telephone": ["+85512677710", "+85570677710"],
        "url": `https://ckmkh.com/tanghuot/`,
        "priceRange": "$$",
        // The product shot carries the shop name and both numbers, so it is the more
        // useful of the two images for a knowledge panel or a rich result.
        "image": [`https://ckmkh.com/th-image.jpg`, `https://ckmkh.com${imgLogo29.src}`],
        // Only what the page itself states. No opening hours or coordinates here —
        // we do not know them, and inventing them would put wrong information in
        // front of someone trying to visit.
        "areaServed": { "@type": "City", "name": "Phnom Penh" },
        "makesOffer": [
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": t.mcTitle,
            "category": "Mooncake", "description": t.mcDesc } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": t.sigTitle,
            "category": "Pastry", "description": t.sigDesc } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": t.fagaoTitle,
            "category": "Steamed Cake", "description": t.fagaoDesc2 } }
        ],
        "sameAs": [
          "https://www.facebook.com/people/%E1%9E%A0%E1%9E%B6%E1%9E%84%E1%9E%93%E1%9F%86-%E1%9E%8F%E1%9E%B6%E1%9F%86%E1%9E%84-%E1%9E%A0%E1%9E%BD%E1%9E%8F/100063625998376/"
        ]
      })}
    />



    <style is:global>
      :root {
        --kh-red: #C5A059;
      }
      .bg-kh-red {
        background-color: #C5A059;
      }
      .text-kh-red {
        color: #C5A059;
      }
      .border-kh-red {
        border-color: var(--kh-red);
      }
      .font-heading {
        font-family: "Hanuman", serif;
      }
      .font-body {
        font-family: "Battambang", sans-serif;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </Fragment>

  <div
    class="bg-slate-950 text-slate-200 font-body antialiased selection:bg-kh-red selection:text-white"
  >
    <header
      class="relative min-h-[calc(100vh-80px)] flex items-center justify-center overflow-hidden border-b border-white/5"
    >
      <Image
        src={imgLogo29}
        alt="នំលោកខែប្រណីត"
        format="avif"
        quality={50}
        width={1920}
        height={1080}
        widths={[400, 800, 1200, 1920]}
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-radial from-transparent via-black/50 to-slate-950 opacity-95"
      >
      </div>

      <div
        class="relative z-10 text-center px-6 max-w-5xl mx-auto pt-16 pb-24 space-y-8"
      >
        <div class="flex justify-center mb-6">
          <Image
            src={imgLogoTanghout}
            alt="Tang Huot Logo"
            format="avif"
            width={250}
            height={250}
            widths={[128, 250, 400]}
            sizes="(max-width: 768px) 128px, 250px"
            loading="eager"
            decoding="async"
            class="h-28 w-auto md:h-40 object-contain drop-shadow-[0_0_15px_rgba(0,0,0,0.8)]"
          />
        </div>

        <h1
          class="text-6xl md:text-8xl font-black text-white leading-tight tracking-wide font-heading drop-shadow-2xl"
        >
          {t.h1}
        </h1>
        <h2
          class="text-2xl md:text-4xl font-bold text-white/90 tracking-widest font-heading drop-shadow-lg"
        >
          {t.heroSub}
          <br class="md:hidden" /><span class="text-kh-red drop-shadow-md"
            >{t.heroHighlight}</span
          >
        </h2>
        <p
          class="text-lg md:text-2xl text-gray-300 mb-16 max-w-3xl mx-auto font-light leading-loose tracking-wide drop-shadow-md"
        >
          {t.heroDesc}
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center pt-8">
          <a
            href="#contact"
            class="bg-kh-red hover:bg-red-700 text-white px-14 py-5 rounded-sm font-bold text-lg transition flex items-center justify-center gap-3 shadow-[0_0_20px_rgba(227,29,43,0.5)] tracking-wider"
          >
            <Phone class="w-5 h-5" stroke-width={2.5} />
            {t.preorderTitle}
          </a>
        </div>
      </div>
    </header>

    <section
      id="abundance"
      class="py-16 md:py-24 border-b border-white/5 relative overflow-hidden bg-slate-950"
    >
      <div class="absolute inset-0 z-0">
        <Image
          src={imgHeroStone}
          alt="Texture"
          format="avif"
          width={1920}
          height={1080}
          widths={[400, 800, 1200, 1920]}
          sizes="100vw"
          class="w-full h-full object-cover opacity-70 mix-blend-luminosity"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 bg-gradient-to-b from-slate-950 via-transparent to-slate-950 opacity-40"
        >
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
          class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center"
        >
          <div
            class="md:col-span-5 space-y-6 md:space-y-8 text-center md:text-left"
          >
            <div
              class="inline-flex items-center gap-3 px-4 py-1.5 bg-amber-500/10 border border-amber-500/30 rounded-full text-amber-500 font-sans font-bold text-xs uppercase tracking-widest"
            >
              <Award class="w-4 h-4" stroke-width={2} />
              <span>{t.sigTag}</span>
            </div>
            <h3
              class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight font-heading drop-shadow-lg"
            >
              {t.sigTitle}
            </h3>
            <div
              class="w-20 h-1 bg-kh-red mx-auto md:mx-0 shadow-[0_0_10px_rgba(227,29,43,0.5)]"
            >
            </div>
            <p
              class="text-xl md:text-2xl text-gray-300 font-light leading-loose tracking-wide drop-shadow-sm"
            >
              {t.sigDesc}
            </p>
          </div>
          <div class="md:col-span-7">
            <div
              class="relative rounded-sm overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 group"
            >
              <Image
                src={imgProducts}
                alt="Products"
                format="avif"
                width={1200}
                height={800}
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="w-full h-auto object-cover transform group-hover:scale-105 transition duration-1000"
                loading="lazy"
                decoding="async"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="mooncakes" class="bg-slate-900 border-b border-white/5">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative h-[40vh] sm:h-[50vh] lg:h-auto overflow-hidden">
          <Image
            src={imgSlice}
            alt="Mooncake Slice"
            format="avif"
            width={1000}
            height={1000}
            widths={[400, 800, 1000]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            class="absolute inset-0 w-full h-full object-cover object-center transform hover:scale-105 transition duration-1000"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div
          class="flex flex-col justify-center p-12 md:p-20 lg:p-24 space-y-8"
        >
          <div
            class="w-14 h-14 bg-slate-950 border border-white/10 rounded-full flex items-center justify-center text-amber-500 shadow-lg"
          >
            <Flame class="w-6 h-6" stroke-width={2} />
          </div>
          <h3
            class="text-4xl md:text-5xl font-black text-white leading-tight font-heading drop-shadow-lg"
          >
            {t.mcTitle}
          </h3>
          <div class="w-20 h-1 bg-kh-red shadow-[0_0_10px_rgba(227,29,43,0.5)]">
          </div>
          <p
            class="text-xl md:text-2xl text-gray-300 font-light leading-loose tracking-wide drop-shadow-sm"
          >
            {t.mcDesc}
          </p>
        </div>
      </div>
    </section>

    <section
      id="fagao"
      class="bg-white border-b border-slate-200 selection:bg-slate-200 selection:text-slate-900"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div
          class="order-2 lg:order-1 flex flex-col justify-center p-12 md:p-20 lg:p-24 space-y-8 bg-slate-50"
        >
          <div
            class="w-14 h-14 bg-white border border-slate-200 rounded-full flex items-center justify-center text-amber-500 shadow-md"
          >
            <Sunrise class="w-6 h-6" stroke-width={2} />
          </div>
          <h3
            class="text-4xl md:text-5xl font-black text-slate-900 leading-tight font-heading"
          >
            {t.fagaoTitle}
          </h3>
          <div class="w-20 h-1 bg-kh-red shadow-[0_0_10px_rgba(227,29,43,0.3)]">
          </div>
          <p
            class="text-xl md:text-2xl text-slate-700 font-light leading-loose tracking-wide"
          >
            {t.fagaoDesc1}
          </p>
          <p
            class="text-xl md:text-2xl text-slate-700 font-light leading-loose tracking-wide"
          >
            {t.fagaoDesc2}
          </p>
        </div>
        <div
          class="order-1 lg:order-2 relative h-[40vh] sm:h-[50vh] lg:h-auto overflow-hidden"
        >
          <Image
            src={imgCholChnam}
            alt="Fa Gao"
            format="avif"
            width={1000}
            height={1000}
            widths={[400, 800, 1000]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            class="absolute inset-0 w-full h-full object-cover object-center transform hover:scale-105 transition duration-1000"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section id="contact" class="bg-slate-950 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div
          class="relative h-[30vh] sm:h-[40vh] lg:h-auto overflow-hidden bg-slate-900"
        >
          <Image
            src={imgSteamer}
            alt="Facility"
            format="avif"
            width={1920}
            height={1080}
            widths={[400, 800, 1200, 1920]}
            sizes="100vw"
            class="absolute inset-0 w-full h-full object-cover opacity-70 mix-blend-luminosity"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"
          >
          </div>
        </div>

        <div
          class="flex flex-col justify-center p-12 md:p-20 lg:p-24 space-y-10 relative z-10"
        >
          <h2
            class="text-5xl md:text-6xl font-black text-white font-heading leading-tight drop-shadow-2xl text-center md:text-left"
          >
            {t.contactTitle}
          </h2>

          <div
            class="bg-slate-900/80 backdrop-blur-sm border border-white/10 p-8 md:p-12 rounded-sm shadow-2xl space-y-8"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="group">
                <p
                  class="text-amber-500 font-bold mb-2 text-sm tracking-widest uppercase"
                >
                  Cellcard (Telegram)
                </p>
                <a
                  href="tel:+85512677710"
                  class="text-3xl md:text-4xl font-bold text-white tracking-wider group-hover:text-kh-red transition duration-300 block"
                  >012 677 710</a
                >
              </div>

              <div class="group">
                <p
                  class="text-amber-500 font-bold mb-2 text-sm tracking-widest uppercase"
                >
                  Smart
                </p>
                <a
                  href="tel:+85570677710"
                  class="text-3xl md:text-4xl font-bold text-white tracking-wider group-hover:text-kh-red transition duration-300 block"
                  >070 677 710</a
                >
              </div>
            </div>

